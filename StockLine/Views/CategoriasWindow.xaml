<Window x:Class="WpfApp1.Views.CategoriasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion de Categorias"
        Height="600"
        Width="900"
        Background="#F2F5F8"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Colores actualizados a azul marino -->
        <Color x:Key="PrimaryColor">#2C3E50</Color>
        <Color x:Key="SuccessColor">#2ECC71</Color>
        <Color x:Key="DangerColor">#E74C3C</Color>
        <Color x:Key="WarningColor">#F39C12</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="PageBackground">#F2F5F8</Color>
        <Color x:Key="BorderLightColor">#2C3E50</Color>
        <Color x:Key="MutedTextColor">#7F8C8D</Color>
        <Color x:Key="MainTextColor">#2C3E50</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource PageBackground}"/>
        <SolidColorBrush x:Key="BorderLight" Color="{StaticResource BorderLightColor}"/>
        <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}"/>
        <SolidColorBrush x:Key="MainText" Color="{StaticResource MainTextColor}"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#20000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F39C12"/>
        </Style>

        <!-- DataGrid estilos -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F2F5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6EAF8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E1BEE7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Icons/fondo.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER MODERNO CON MINIMIZAR Y CERRAR -->
        <Border Grid.Row="0" Background="#FF2C3E50" CornerRadius="12,12,0,0" Padding="0,0,0,0" Margin="0,0,0,20">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Gestion de Categorías" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Administra las categorías de productos" FontSize="14" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="_" Width="40" Height="32" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#7F8C8D" Cursor="Hand" Click="MinimizeWindow_Click"/>
                    <Button Content="☐" Width="40" Height="32" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#7F8C8D" Cursor="Hand" Click="MaximizeWindow_Click"/>
                    <Button Content="x" Width="40" Height="32" Background="#FF6B6B" BorderThickness="0" FontSize="16" Foreground="White" Cursor="Hand" Click="BtnCerrar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Bar y Botón Nueva Categoria -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="txtBuscar" 
                            Height="44"
                            Padding="16,0"
                            FontSize="16"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            Width="400"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            TextChanged="TxtBuscar_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Content="+ Nueva Categoría"
                            Style="{StaticResource SuccessButton}"
                            Height="44"
                            Width="180"
                            Margin="24,0,0,0"
                            Padding="24,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Click="BtnNuevaCategoria_Click"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="CategoriasGrid"
                         Grid.Row="1"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserAddRows="False"
                         SelectionMode="Single"
                         RowHeight="50"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         HorizontalGridLinesBrush="#F0F2F5"
                         BorderThickness="0"
                         Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="80"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTemplateColumn Header="Acciones" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Editar" 
                                               Width="80"
                                               Height="32"
                                               Margin="0,0,8,0"
                                               Style="{StaticResource WarningButton}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Click="BtnEditar_Click"/>
                                        <Button Content="Eliminar" 
                                               Width="90"
                                               Height="32"
                                               Style="{StaticResource DangerButton}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Click="BtnEliminar_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer -->
                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Margin="0,16,0,0">
                    <TextBlock x:Name="txtTotalCategorias" 
                              Text="Total: 0 categorias"
                              FontSize="14"
                              Foreground="{StaticResource MutedText}"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"/>
                    <Button Content="Cerrar" 
                           Width="100"
                           Height="38"
                           Background="Transparent"
                           Foreground="{StaticResource MutedText}"
                           BorderBrush="{StaticResource BorderLight}"
                           BorderThickness="1"
                           Cursor="Hand"
                           Click="BtnCerrar_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
