<Window x:Class="WpfApp1.Views.CategoriasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion de Categorias"
        Height="600"
        Width="900"
        Background="#F2F5F8"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Color x:Key="AccentColor">#0A84FF</Color>
        <Color x:Key="SuccessColor">#34C759</Color>
        <Color x:Key="DangerColor">#FF3B30</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="PageBackground">#F2F5F8</Color>
        <Color x:Key="BorderLightColor">#E6E9ED</Color>
        <Color x:Key="MutedTextColor">#6E7780</Color>
        <Color x:Key="MainTextColor">#0B1220</Color>

        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource PageBackground}"/>
        <SolidColorBrush x:Key="BorderLight" Color="{StaticResource BorderLightColor}"/>
        <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}"/>
        <SolidColorBrush x:Key="MainText" Color="{StaticResource MainTextColor}"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#20000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Gestion de Categorias" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="{StaticResource MainText}"/>
                    <TextBlock Text="Administra las categorias de productos" 
                              FontSize="14" 
                              Foreground="{StaticResource MutedText}"
                              Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                       Content="+ Nueva Categoria" 
                       Style="{StaticResource SuccessButton}"
                       Width="170"
                       Click="BtnNuevaCategoria_Click"/>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <TextBox x:Name="txtBuscar" 
                        Grid.Row="0"
                        Height="40"
                        Padding="12"
                        FontSize="14"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1"
                        Margin="0,0,0,16"
                        TextChanged="TxtBuscar_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- DataGrid -->
                <DataGrid x:Name="CategoriasGrid"
                         Grid.Row="1"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserAddRows="False"
                         SelectionMode="Single"
                         RowHeight="50"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         HorizontalGridLinesBrush="#F0F2F5"
                         BorderThickness="0"
                         Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="80"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTemplateColumn Header="Acciones" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="?? Editar" 
                                               Width="80"
                                               Height="32"
                                               Margin="0,0,8,0"
                                               Background="{StaticResource AccentBrush}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Click="BtnEditar_Click"/>
                                        <Button Content="??? Eliminar" 
                                               Width="90"
                                               Height="32"
                                               Background="{StaticResource DangerBrush}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Click="BtnEliminar_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer -->
                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Margin="0,16,0,0">
                    <TextBlock x:Name="txtTotalCategorias" 
                              Text="Total: 0 categorias"
                              FontSize="14"
                              Foreground="{StaticResource MutedText}"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"/>
                    <Button Content="Cerrar" 
                           Width="100"
                           Height="38"
                           Background="Transparent"
                           Foreground="{StaticResource MutedText}"
                           BorderBrush="{StaticResource BorderLight}"
                           BorderThickness="1"
                           Cursor="Hand"
                           Click="BtnCerrar_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
