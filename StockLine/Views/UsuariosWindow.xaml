<Window x:Class="WpfApp1.Views.UsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1.Views"
        Title="Stockline - Gestión de Usuarios"
        Height="900"
        Width="1600"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Colores y estilos modernos similares a Ayuntamientos -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#2ECC71"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E74C3C"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F39C12"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E4E8"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="HoverColor" Color="#E3F2FD"/>

        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        </Style>
        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="24" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="70"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F2F5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6EAF8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E1BEE7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER DE LA VENTANA -->
            <Border Grid.Row="0" 
                    Background="#FF2C3E50" 
                    CornerRadius="16,16,0,0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid Height="80" Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" 
                            CornerRadius="14" 
                            Background="{StaticResource PrimaryColor}"
                            VerticalAlignment="Center">
                        <Image Source="/assets/icons/usuario.png" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" 
                              VerticalAlignment="Center" 
                              Margin="20,0,0,0">
                        <TextBlock Text="Gestión de Usuarios" 
                                 Style="{StaticResource TitleStyle}" Foreground="White"/>
                        <TextBlock Text="Administra todos los usuarios del sistema" 
                                 Style="{StaticResource SubtitleStyle}" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">
                        <Button Content="─" 
                               Width="44" Height="44" 
                               Background="Transparent" 
                               BorderThickness="0"
                               FontSize="20"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Cursor="Hand"
                               Click="MinimizeWindow_Click"
                               Margin="0,0,8,0"/>
                        <Button Content="☐" 
                               Width="44" Height="44" 
                               Background="Transparent" 
                               BorderThickness="0"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Cursor="Hand"
                               Click="MaximizeWindow_Click"
                               Margin="0,0,8,0"/>
                        <Button Content="✕" 
                               Width="40" Height="30" 
                               Background="#FF6B6B" 
                               BorderThickness="0"
                               FontSize="16"
                               Foreground="White"
                               Cursor="Hand"
                               Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO PRINCIPAL -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.Background>
                    <ImageBrush ImageSource="/Assets/Icons/fondo.jpg"/>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de búsqueda, filtro y acciones -->
                <Border Grid.Row="0" 
                        Style="{StaticResource CardStyle}"
                        Margin="24,24,24,16"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <!-- Búsqueda -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="txtBuscar" 
                                   Style="{StaticResource ModernTextBox}"
                                   Width="500"
                                   HorizontalAlignment="Left"
                                   TextChanged="TxtBuscar_TextChanged"/>
                            <TextBlock Text="🔍 Buscar por nombre, email o rol..." 
                                     Foreground="{StaticResource TextSecondaryColor}"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     Margin="16,0,0,0"
                                     IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <!-- Filtro activos/inactivos/todos -->
                        <ComboBox x:Name="cbFiltroEstado" Grid.Column="1" Width="150" Height="32" Margin="24,0,0,0" VerticalAlignment="Center" SelectionChanged="CbFiltroEstado_SelectionChanged">
                            <ComboBoxItem Content="Activos" IsSelected="True"/>
                            <ComboBoxItem Content="Inactivos"/>
                            <ComboBoxItem Content="Todos"/>
                        </ComboBox>
                        <!-- Botón Nuevo Usuario -->
                        <Button Grid.Column="2" 
                                Content="+ Nuevo Usuario" 
                                Style="{StaticResource SuccessButton}"
                                Width="180"
                                Height="32"
                                Margin="24,0,0,0"
                                VerticalAlignment="Center"
                                Click="BtnNuevoUsuario_Click"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Tabla de usuarios -->
                <Border Grid.Row="1" 
                        Style="{StaticResource CardStyle}"
                        Margin="24,0,24,16">
                    <DataGrid x:Name="dgUsuarios" 
                            Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding UsuarioID}" Width="80"/>
                            <DataGridTemplateColumn Header="Usuario" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" 
                                                   CornerRadius="21"
                                                   Margin="0,0,12,0"
                                                   Background="{StaticResource PrimaryColor}">
                                                <TextBlock Text="{Binding InicialNombre}" 
                                                         FontSize="18" 
                                                         FontWeight="Bold" 
                                                         Foreground="White"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NombreCompleto}" 
                                                         FontWeight="SemiBold"
                                                         Foreground="{StaticResource TextPrimaryColor}"/>
                                                <TextBlock Text="{Binding Email}" 
                                                         FontSize="12"
                                                         Foreground="{StaticResource TextSecondaryColor}"
                                                         Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Rol" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="RoleBorder"
                                               CornerRadius="18"
                                               Padding="18,10"
                                               HorizontalAlignment="Center"
                                               MinWidth="140">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding RolColor}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RolNombre}" Value="Admin">
                                                            <Setter Property="Background" Value="#90CAF9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RolNombre}" Value="Comercial">
                                                            <Setter Property="Background" Value="#A5D6A7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Image Width="24" Height="24" Margin="0,0,8,0">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RolNombre}" Value="Admin">
                                                                    <Setter Property="Source" Value="/assets/icons/AdminRol.png"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RolNombre}" Value="Comercial">
                                                                    <Setter Property="Source" Value="/assets/icons/ComercialRol.png"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RolNombre}" Value="Usuario">
                                                                    <Setter Property="Source" Value="/assets/icons/usuarioRol.png"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding RolNombre}" 
                                                          Foreground="White"
                                                          FontSize="13"
                                                          FontWeight="Bold"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Acciones" Width="340">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Ver"
                                                   Width="90"
                                                   Height="36"
                                                   Margin="4,0"
                                                   Background="#2C3E50"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   Tag="{Binding}"
                                                   Click="BtnVer_Click"
                                                   Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="Editar"
                                                   Width="90"
                                                   Height="36"
                                                   Margin="4,0"
                                                   Background="#F39C12"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   Tag="{Binding}"
                                                   Click="BtnEditar_Click"
                                                   Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="Eliminar"
                                                   Width="100"
                                                   Height="36"
                                                   Margin="4,0"
                                                   Background="#EF5350"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   Tag="{Binding}"
                                                   Click="BtnEliminar_Click"
                                                   Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Footer con estadísticas -->
                <Border Grid.Row="2" 
                        Background="Transparent"
                        Margin="24,0,24,24">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTotalUsuarios"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextSecondaryColor}"
                                     FontSize="13">
                                <Run Text="Total de usuarios: "/>
                                <Run Text="0" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock x:Name="txtTotalAdmin"
                                     Margin="30,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="#E74C3C"
                                     FontSize="13"
                                     FontWeight="Bold"
                                     Text="Admin: 0"/>
                            <TextBlock x:Name="txtTotalComercial"
                                     Margin="30,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="#27AE60"
                                     FontSize="13"
                                     FontWeight="Bold"
                                     Text="Comercial: 0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
