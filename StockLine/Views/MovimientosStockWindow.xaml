<Window x:Class="WpfApp1.Views.MovimientosStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimientos de Stock" Height="800" Width="1400" WindowStartupLocation="CenterOwner" Background="#F5F7FA" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanMinimize">
    <Border Background="White" CornerRadius="12" Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra superior moderna y movible -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12" MouseLeftButtonDown="BarraSuperior_MouseLeftButtonDown">
                <TextBlock Text="Movimientos de Stock" FontWeight="Bold" FontSize="18" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="_" Width="36" Height="28" Background="#E2E8F0" BorderThickness="0" FontSize="14" Foreground="#7F8C8D" Cursor="Hand" Click="MinimizeWindow_Click"/>
                    <Button Content="?" Width="36" Height="28" Background="#E2E8F0" BorderThickness="0" FontSize="14" Foreground="#7F8C8D" Cursor="Hand" Click="MaximizeWindow_Click"/>
                    <Button Content="?" Width="36" Height="28" Background="#FF6B6B" BorderThickness="0" FontSize="14" Foreground="White" Cursor="Hand" Click="CloseWindow_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Top bar filtros -->
            <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,12" Grid.Row="1" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="cbProducto" Width="200" DisplayMemberPath="Nombre" SelectedValuePath="ProductoID" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cbTipo" Width="110" Margin="0,0,8,0">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Entrada"/>
                        <ComboBoxItem Content="Salida"/>
                    </ComboBox>
                    <DatePicker x:Name="dpFrom" Width="120" Margin="0,0,8,0"/>
                    <DatePicker x:Name="dpTo" Width="120" Margin="0,0,8,0"/>
                    <Button x:Name="btnBuscar" Content="Buscar" Width="90" Height="32" Margin="0,0,8,0" Click="Buscar_Click" Background="#3498DB" Foreground="White" FontWeight="SemiBold"/>
                    <Button x:Name="btnExportar" Content="Exportar CSV" Width="110" Height="32" Margin="0,0,8,0" Click="Exportar_Click" Background="#E2E8F0" Foreground="#2C3E50"/>
                    <Button x:Name="btnCrear" Content="Crear movimiento" Width="140" Height="32" Click="Crear_Click" Background="#27AE60" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Tabla -->
            <DataGrid x:Name="dgMovimientos" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,0" RowHeight="36" HeadersVisibility="Column" GridLinesVisibility="None" Background="#F8FAFC" BorderThickness="0" ColumnHeaderHeight="36">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#2C3E50"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="Padding" Value="8,0,8,0"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="Padding" Value="8,0,8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="140"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="80"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="*"/>
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioNombre}" Width="120"/>
                    <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="180"/>
                    <DataGridTemplateColumn Header="Acciones" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Ver" Click="Ver_Click" Background="#3498DB" Foreground="White" Height="26" Width="56" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Footer paginacion simple -->
            <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock x:Name="txtPaginacion" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#64748B"/>
                <Button Content="Anterior" Click="Anterior_Click" Margin="0,0,8,0" Height="28" Width="80"/>
                <Button Content="Siguiente" Click="Siguiente_Click" Height="28" Width="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>