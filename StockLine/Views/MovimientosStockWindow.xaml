<Window x:Class="WpfApp1.Views.MovimientosStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimientos de Stock" Height="800" Width="1400" WindowStartupLocation="CenterOwner" Background="#F5F7FA" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanMinimize">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#FF2C3E50"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E4E8"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="HoverColor" Color="#EBF5FB"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="24" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                                <ContentPresenter Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"/>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                    <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="2" CornerRadius="10" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="24" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="200">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F2F5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6EAF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/Icons/fondo.jpg"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- HEADER -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" CornerRadius="16,16,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid Height="70" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="Movimientos de Stock" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Solo entradas y salidas de productos" FontSize="13" Foreground="#BFD9EA"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="[ ]" FontFamily="Segoe UI Symbol" Width="40" Height="40" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="White" Cursor="Hand" Click="MaximizeWindow_Click"/>
                        <Button Content="X" FontFamily="Segoe UI Symbol" Width="40" Height="40" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="White" Cursor="Hand" Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- FILTROS -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="24,24,24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="cbProducto" Style="{StaticResource ModernComboBox}" Width="220" Margin="0,0,12,0"/>
                    <ComboBox x:Name="cbTipo" Style="{StaticResource ModernComboBox}" Width="140" Margin="0,0,12,0">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Entrada"/>
                        <ComboBoxItem Content="Salida"/>
                    </ComboBox>
                    <DatePicker x:Name="dpFrom" Width="140" Margin="0,0,12,0"/>
                    <DatePicker x:Name="dpTo" Width="140" Margin="0,0,12,0"/>
                    <Button x:Name="btnBuscar" Content="Buscar" Style="{StaticResource PrimaryButton}" Width="120" Margin="0,0,0,0" Click="Buscar_Click"/>
                </StackPanel>
            </Border>
            <!-- TABLA -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="24,24,24,0">
                <DataGrid x:Name="dgMovimientos" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="48" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0" ColumnHeaderHeight="44">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="140"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="100"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="2*"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioNombre}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <!-- FOOTER -->
            <Border Grid.Row="3" Background="Transparent" Margin="24,16,24,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtPaginacion" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" Foreground="{StaticResource TextSecondaryColor}"/>
                    <Button Content="Anterior" Click="Anterior_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" Height="32" Width="100"/>
                    <Button Content="Siguiente" Click="Siguiente_Click" Style="{StaticResource PrimaryButton}" Height="32" Width="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>