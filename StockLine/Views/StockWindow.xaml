<Window x:Class="WpfApp1.Views.StockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WpfApp1.Models"
        Title="Stock - Control" Height="780" Width="1200"
        Background="#F7F8FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Paleta y estilos reutilizables -->
        <SolidColorBrush x:Key="Accent">#1976D2</SolidColorBrush>
        <SolidColorBrush x:Key="AccentLight">#E9F2FF</SolidColorBrush>
        <SolidColorBrush x:Key="CardBg">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Muted">#6B7280</SolidColorBrush>
        <SolidColorBrush x:Key="BorderLight">#E9EDF2</SolidColorBrush>

        <CornerRadius x:Key="Radius">10</CornerRadius>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.95"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid base -->
        <Style TargetType="DataGrid" x:Key="NiceGrid">
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F4F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F9FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid  Background="{DynamicResource AccentLight}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- header -->
            <RowDefinition Height="Auto"/>
            <!-- KPI cards -->
            <RowDefinition Height="*"/>
            <!-- main content -->
            <RowDefinition Height="Auto"/>
            <!-- footer actions -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Stock" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Control de inventario — revisa niveles, ubica y ajusta stock" Foreground="Black" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,0,0">

                <Button Style="{StaticResource PrimaryButton}" Content="Nuevo producto" Click="BtnNuevo_Click" Width="150"/>
            </StackPanel>
        </DockPanel>

        <!-- KPI Cards -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,14">
            <Border Style="{StaticResource Card}" Width="220" Height="86" Margin="10" BorderBrush="Black">
                <StackPanel>
                    <TextBlock Text="Total productos" Foreground="Black" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="txtTotalProductos" Text="{Binding TotalProductos}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Width="220" Height="86" Margin="10" BorderBrush="Black">
                <StackPanel>
                    <TextBlock Text="Sin stock / crítico" Foreground="{DynamicResource {x:Static SystemColors.DesktopBrushKey}}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="txtCriticos" Text="{Binding Criticos}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{StaticResource Accent}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Width="220" Height="86" Margin="10" BorderBrush="Black">
                <StackPanel>
                    <TextBlock Text="Unidades totales" Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="txtUnidades" Text="{Binding Unidades}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>


        <!-- MAIN: filters + grid -->
        <Grid Grid.Row="2" Background="{DynamicResource AccentLight}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters row -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left" Margin="8,0,0,10">

                <Border Background="{DynamicResource AccentLight}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Margin="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"  VerticalAlignment="Center" Margin="8">
                        <TextBlock Text="Categoria" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" Margin="0,0,6,0" FontWeight="Bold"/>
                        <ComboBox x:Name="cbCategoria"
                          Width="160" Height="28"
                          ItemsSource="{Binding Categorias}"
                          DisplayMemberPath="Nombre"
                          SelectedItem="{Binding SelectedCategoria, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="chkSoloCriticos" Content="Solo críticos" VerticalAlignment="Center" Margin="8,6,0,0" Foreground="#FF1D1818" FontWeight="Bold"/>
                <Button Content="Limpiar filtros" Width="140" Style="{StaticResource GhostButton}" Click="BtnLimpiarFiltros_Click" Background="#FF1976D2" FontWeight="Bold" Margin="15" Foreground="White" BorderBrush="{x:Null}"/>
                <Button Content="Exportar a CSV" Style="{StaticResource GhostButton}" Width="140" Click="BtnExportarExcel_Click" FontWeight="Bold" BorderBrush="{x:Null}" Background="#FF34C759" Foreground="White" Margin="10"/>
            </StackPanel>

            <!-- DataGrid -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="10" Background="{DynamicResource AccentLight}">
                <DataGrid x:Name="StockGrid"
          AutoGenerateColumns="False"
          ItemsSource="{Binding ProductosFiltrados}"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True"
          MouseRightButtonDown="StockGrid_MouseRightButtonDown" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ProductoID}" Width="80"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="2*"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Stock}" Width="120"/>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Editar producto" Click="EditarProducto_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Icons/editar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Eliminar producto" Click="EliminarProducto_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Icons/borrar.png"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>

        </Grid>

        <!-- FOOTER: acciones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"  Margin="0,16,0,0">
            <Button Content="Salir" Style="{StaticResource GhostButton}" Width="140" Click="BtnExportar_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#FFFF5A5A" FontWeight="Bold" Foreground="White" Margin="10" BorderBrush="{x:Null}"/>
            <Button Content="Importar" Style="{StaticResource GhostButton}" Width="120" Click="BtnImportar_Click" Foreground="White" FontWeight="Bold" Background="#FF1976D2" Margin="10"/>
        </StackPanel>

    </Grid>
</Window>
