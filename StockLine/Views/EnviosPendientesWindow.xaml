<Window x:Class="WpfApp1.Views.EnviosPendientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envíos Pendientes"
        Height="904"
        Width="1498"
        Background="#F2F5F8"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        >


    <Window.Resources>

        <Color x:Key="AccentColor">#0A84FF</Color>

        <Color x:Key="SuccessColor">#34C759</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="PageBackground">#F2F5F8</Color>
        <Color x:Key="BorderLightColor">#E6E9ED</Color>
        <Color x:Key="MutedTextColor">#6E7780</Color>
        <Color x:Key="MainTextColor">#0B1220</Color>

        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource PageBackground}"/>
        <SolidColorBrush x:Key="BorderLight" Color="{StaticResource BorderLightColor}"/>
        <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}"/>
        <SolidColorBrush x:Key="MainText" Color="{StaticResource MainTextColor}"/>

        <CornerRadius x:Key="CardCorner">12</CornerRadius>


        <Style x:Key="TitleLarge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
        </Style>

        <!-- Botón primario -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.95"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón ghost -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0A000000"/>
                    <Setter Property="Opacity" Value="0.04"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card-->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardCorner}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#20000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox buscador -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="40,0,12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <!-- Icono simple (usa emoji para compatibilidad cross-font) -->
                                <TextBlock Text="🔍" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="36,0,36,0" VerticalAlignment="Center"/>
                                <Button x:Name="PART_Clear" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <TextBlock Text="✖" FontSize="12" Foreground="{StaticResource MutedText}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="NiceDataGrid" TargetType="DataGrid">
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFD"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F2F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        </Style>


        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7FBFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Grid Margin="18" Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,18,0" Height="740">
            <StackPanel>
                <!-- small brand -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="E" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Envíos" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MainText}"/>
                        <TextBlock Text="Panel" Foreground="{StaticResource MutedText}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- navegación simple -->
                <StackPanel Margin="0,0,0,8">
                    <Button Content="Inicio" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="VolverAlInicio_Click" BorderBrush="Black" FontWeight="Bold"/>
                    <Button Content="Todos los envíos" Style="{StaticResource GhostButton}" Margin="0,0,0,10" Click="AplicarTodos_Click" Foreground="Black" BorderBrush="Black" FontWeight="Bold"/>
                </StackPanel>

                <Separator Margin="0,6"/>

                <TextBlock Text="Filtros" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,8"/>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Estado" FontSize="12" Foreground="{DynamicResource MainText}" Margin="0,6,0,6" FontWeight="Bold" FontStyle="Italic"/>
                    <ComboBox x:Name="cbEstado" Width="230" Height="30" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLight}">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Pendiente"/>
                        <ComboBoxItem Content="Preparado"/>
                        <ComboBoxItem Content="Enviado"/>
                    </ComboBox>
                    <Button Content="Aplicar" Style="{StaticResource GhostButton}" Height="20" Width="120" Margin="0,10,0,6" Click="AplicarEstado_Click" BorderBrush="Black" FontWeight="Bold" Background="White"/>

                    <TextBlock Text="Últimos envíos" FontSize="12" Foreground="{DynamicResource MainText}" Margin="0,8,0,6" FontWeight="Bold" FontStyle="Italic"/>
                    <ComboBox x:Name="cbUltimosEnvios" Width="230" Height="30" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLight}">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                    </ComboBox>
                    <Button Content="Aplicar" Style="{StaticResource GhostButton}" Width="120" Height="20" Margin="0,10,0,6" Click="AplicarUltimosEnvios_Click" BorderBrush="Black" FontWeight="Bold"/>

                    <TextBlock Text="Ayuntamiento" FontSize="12" Foreground="{DynamicResource MainText}" Margin="0,8,0,6" FontWeight="Bold" FontStyle="Italic"/>
                    <ComboBox x:Name="cbAyuntamiento" Width="230" Height="30" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderLight}"/>
                    <Button Content="Aplicar" Style="{StaticResource GhostButton}" Width="130" Height="20" Margin="0,10,0,6" Click="AplicarAyuntamiento_Click" FontWeight="Bold" BorderBrush="#FF101010"/>

                    <Separator Margin="0,8"/>

                    <Button Content="Exportar a CSV" Width="240" Height="40" Foreground="White" Margin="0,6,0,0" Click="ExportarCsv_Click">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource SuccessColor}"/>
                        </Button.Background>
                    </Button> 

                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CONTENIDO -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="500" HorizontalAlignment="Left">
                    <TextBlock Text="Envíos pendientes" Style="{StaticResource TitleLarge}" VerticalAlignment="Center" />
                    <TextBlock Text="  •  Dashboard" Foreground="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox x:Name="txtSearch" Width="200" Style="{StaticResource SearchBox}" TextChanged="TxtSearch_TextChanged" Foreground="Black" Background="#FFF9F9F9" />
                    <Button Content="Nuevo envío" Style="{StaticResource PrimaryButton}" Width="150" Margin="12,0,0,0" Click="AñadirEnvio_Click"/>
                </StackPanel>
            </Grid>

            <!-- GRID / TABLA -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado interior-->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <!-- placeholder para futuros controles -->
                    </StackPanel>

                    <DataGrid x:Name="EnviosGrid" 
                             Grid.Row="1" 
                             Style="{StaticResource NiceDataGrid}" 
                             AutoGenerateColumns="False"
                             MouseDoubleClick="EnviosGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ver Detalles / Editar" Click="Editar_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="👁" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Marcar como Preparado" Click="Finalizar_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✓" FontSize="14" Foreground="#2ECC71"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Eliminar Envio" Click="Eliminar_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🗑" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding EnvioID}" Width="80"/>
                            <DataGridTextColumn Header="Ayuntamiento" Binding="{Binding AyuntamientoNombre}" Width="2*"/>
                            <DataGridTextColumn Header="Comercial" Binding="{Binding ComercialNombre}" Width="1.5*"/>
                            <DataGridTextColumn Header="Fecha envio" Binding="{Binding FechaEnvio, StringFormat='dd/MM/yyyy'}" Width="120"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                            <DataGridTextColumn Header="Referencia" Binding="{Binding NumeroReferencia}" Width="140"/>
                            <DataGridTextColumn Header="Modificado por" Binding="{Binding UsuarioModificadorNombre}" Width="150"/>
                            <DataGridTextColumn Header="Fecha modificación" Binding="{Binding FechaModificacion, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- FOOTER -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>



                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Exportar" Width="110" Height="36" Margin="0,0,10,0" Background="{StaticResource SuccessBrush}" Foreground="White" Click="ExportarCsv_Click"/>
                    <Button Content="Nuevo" Width="120" Height="36" Style="{StaticResource PrimaryButton}" Click="AñadirEnvio_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
