<Window x:Class="WpfApp1.Views.EnviosPendientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stockline - Envíos Pendientes"
        Height="900"
        Width="1600"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Colores modernos -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#2ECC71"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E74C3C"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F39C12"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E4E8"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="HoverColor" Color="#EBF5FB"/>

        <!-- Estilo para títulos -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Estilo para cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="24" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario moderno -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón Success -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
        </Style>

        <!-- TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox moderno -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            ClickMode="Press"/>
                                <ContentPresenter Margin="12,0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Content="{TemplateBinding SelectionBoxItem}"/>
                                <TextBlock Text="▼" 
                                         FontSize="10"
                                         Foreground="{StaticResource TextSecondaryColor}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,12,0"/>
                                <Popup x:Name="PART_Popup"
                                     IsOpen="{TemplateBinding IsDropDownOpen}"
                                     Placement="Bottom"
                                     AllowsTransparency="True">
                                    <Border Background="{StaticResource SurfaceColor}"
                                          BorderBrush="{StaticResource BorderColor}"
                                          BorderThickness="2"
                                          CornerRadius="10"
                                          Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="24" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="200">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid moderno -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F2F5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6EAF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label de filtro -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </Window.Resources>

    <!-- Borde exterior de la ventana -->
    <Border Background="White" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER DE LA VENTANA -->
            <Border Grid.Row="0" 
                    Background="#FF2C3E50" 
                    CornerRadius="16,16,0,0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid Height="80" Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo/Icono -->
                    <Border Width="56" Height="56" 
                            CornerRadius="14"
                            VerticalAlignment="Center" Background="Black">
                        <Image Source="/Assets/Icons/stock.png"
                               Width="32" Height="32"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <!-- Título -->
                    <StackPanel Grid.Column="1" 
                              VerticalAlignment="Center" 
                              Margin="20,0,0,0">
                        <TextBlock Text="Gestión de Envíos" 
                                 Style="{StaticResource TitleStyle}" Foreground="White"/>
                        <TextBlock Text="Administra y controla todos los envíos del sistema" 
                                 Style="{StaticResource SubtitleStyle}"/>
                    </StackPanel>

                    <!-- Botones de control de ventana -->
                    <StackPanel Grid.Column="2" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">
                        <Button Content="─" 
                               Width="44" Height="44" 
                               Background="Transparent" 
                               BorderThickness="0"
                               FontSize="20"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Cursor="Hand"
                               Click="MinimizeWindow_Click"
                               Margin="0,0,8,0"/>
                        <Button Content="✕" 
                               Width="44" Height="44" 
                               Background="Transparent" 
                               BorderThickness="0"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Cursor="Hand"
                               Click="VolverAlInicio_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO PRINCIPAL -->
            <Grid Grid.Row="1" Background="{StaticResource BackgroundColor}" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PANEL LATERAL DE FILTROS -->
                <Border Grid.Column="0" 
                        Style="{StaticResource CardStyle}"
                        Margin="24,24,12,24" Background="#FF2C3E50">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Sección de navegación -->
                            <TextBlock Text="🎯 Navegación" 
                                     FontSize="16" 
                                     FontWeight="Bold"
                                     Foreground="{StaticResource TextPrimaryColor}"
                                     Margin="0,0,0,16"/>

                            <Button Content="Volver al Inicio" 
                                  Style="{StaticResource SecondaryButton}" 
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,8"
                                  Click="VolverAlInicio_Click" Foreground="White" FontWeight="Bold"/>

                            <Button Content="Todos los Envíos" 
                                  Style="{StaticResource SecondaryButton}" 
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,16"
                                  Click="AplicarTodos_Click" Foreground="White" FontWeight="Bold"/>

                            <Separator Margin="0,8,0,20" Background="{StaticResource BorderColor}"/>

                            <!-- Filtros -->
                            <TextBlock Text="🔍 Filtros" 
                                     FontSize="16" 
                                     FontWeight="Bold"
                                     Foreground="{StaticResource TextPrimaryColor}"
                                     Margin="0,0,0,16"/>

                            <!-- Filtro por Estado -->
                            <TextBlock Text="Estado del Envío" 
                                     Style="{StaticResource FilterLabel}" Foreground="White" FontWeight="Bold"/>
                            <ComboBox x:Name="cbEstado" 
                                    Style="{StaticResource ModernComboBox}"
                                    Margin="0,0,0,8">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="Pendiente"/>
                                <ComboBoxItem Content="Preparado"/>
                                <ComboBoxItem Content="Enviado"/>
                                <ComboBoxItem Content="Archivado" x:Name="itemArchivado" IsEnabled="False"/>
                            </ComboBox>
                            <Button Content="Aplicar Filtro" 
                                  Style="{StaticResource PrimaryButton}" 
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,20"
                                  Click="AplicarEstado_Click"/>

                            <!-- Filtro Últimos Envíos -->
                            <TextBlock Text="Cantidad a Mostrar" 
                                     Style="{StaticResource FilterLabel}" FontWeight="Bold" Foreground="White"/>
                            <ComboBox x:Name="cbUltimosEnvios" 
                                    Style="{StaticResource ModernComboBox}"
                                    Margin="0,0,0,8">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="20"/>
                                <ComboBoxItem Content="50"/>
                            </ComboBox>
                            <Button Content="Aplicar Filtro" 
                                  Style="{StaticResource PrimaryButton}" 
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,20"
                                  Click="AplicarUltimosEnvios_Click"/>

                            <!-- Filtro por Ayuntamiento -->
                            <TextBlock Text="Ayuntamiento" 
                                     Style="{StaticResource FilterLabel}" Foreground="White" FontWeight="Bold"/>
                            <ComboBox x:Name="cbAyuntamiento" 
                                    Style="{StaticResource ModernComboBox}"
                                    Margin="0,0,0,8"/>
                            <Button Content="Aplicar Filtro" 
                                  Style="{StaticResource PrimaryButton}" 
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,24"
                                  Click="AplicarAyuntamiento_Click"/>

                            <Separator Margin="0,8,0,20" Background="{StaticResource BorderColor}"/>

                            <!-- Botón Exportar -->
                            <Button Content="Exportar a CSV" 
                                  Style="{StaticResource SuccessButton}" 
                                  HorizontalAlignment="Stretch"
                                  Height="48"
                                  Click="ExportarCsv_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- PANEL PRINCIPAL -->
                <Grid Grid.Column="1" Margin="12,24,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de búsqueda y acciones -->
                    <Border Grid.Row="0" 
                            Style="{StaticResource CardStyle}"
                            Margin="0,0,0,16"
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Búsqueda -->
                            <Grid Grid.Column="0">
                                <TextBox x:Name="txtSearch" 
                                       Style="{StaticResource ModernTextBox}"
                                       Width="400"
                                       HorizontalAlignment="Left"
                                       TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock Text="🔍 Buscar por ayuntamiento, ID o producto..." 
                                         Foreground="{StaticResource TextSecondaryColor}"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         Margin="16,0,0,0"
                                         IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Botón Nuevo Envío -->
                            <Button Grid.Column="1" 
                                  Content="+ Nuevo Envío" 
                                  Style="{StaticResource PrimaryButton}"
                                  Width="160"
                                  Click="AñadirEnvio_Click"/>
                        </Grid>
                    </Border>

                    <!-- Tabla de envíos -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <DataGrid x:Name="EnviosGrid" 
                                Style="{StaticResource ModernDataGrid}"
                                MouseDoubleClick="EnviosGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="👁 Ver Detalles / Editar" Click="Editar_Click"/>
                                    <Separator/>
                                    <MenuItem Header="✓ Marcar como Preparado" Click="Finalizar_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🗑 Eliminar Envío" Click="Eliminar_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📦 Archivar Envío" Click="Archivar_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding EnvioID}" Width="80"/>
                                <DataGridTextColumn Header="Ayuntamiento" Binding="{Binding AyuntamientoNombre}" Width="2*"/>
                                <DataGridTextColumn Header="Comercial" Binding="{Binding ComercialNombre}" Width="1.5*"/>
                                <DataGridTextColumn Header="Fecha Envío" Binding="{Binding FechaEnvio, StringFormat='dd/MM/yyyy'}" Width="120"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                                <DataGridTextColumn Header="Referencia" Binding="{Binding NumeroReferencia}" Width="140"/>
                                <DataGridTextColumn Header="Modificado por" Binding="{Binding UsuarioModificadorNombre}" Width="150"/>
                                <DataGridTextColumn Header="Fecha Modificación" Binding="{Binding FechaModificacion, StringFormat='dd/MM/yyyy HH:mm'}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Footer con estadísticas -->
                    <Border Grid.Row="2" 
                            Background="Transparent"
                            Margin="0,16,0,0">
                        <Grid>
                            <TextBlock VerticalAlignment="Center"
                                     Foreground="{StaticResource TextSecondaryColor}"
                                     FontSize="13">
                                <Run Text="Total de envíos: "/>
                                <Run Text="{Binding Items.Count, ElementName=EnviosGrid, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
