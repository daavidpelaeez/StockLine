<Window x:Class="WpfApp1.Views.AddEditAyuntamientos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="AddEditAyuntamientos" Height="450" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ayuntamiento" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,6,0,6">
            <TextBlock Text="Nombre" FontWeight="SemiBold" />
            <TextBox x:Name="TxtNombre" Height="32" Margin="0,4" />

            <TextBlock Text="Dirección" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtDireccion" Height="32" Margin="0,4"/>

            <UniformGrid Columns="3" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Ciudad" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtCiudad" Height="32" Margin="0,4"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Código postal" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtCP" Height="32" Margin="0,4"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Teléfono" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtTelefono" Height="32" Margin="0,4"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtEmail" Height="32" Margin="0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="120"  Click="BtnCancel_Click"/>
            <Button Content="Guardar" Width="120" Background="#FF19960F" Foreground="White" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
