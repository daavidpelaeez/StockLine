<Window x:Class="WpfApp1.Views.PerfilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        xmlns:viewModels="clr-namespace:WpfApp1.ViewModels"
        mc:Ignorable="d"
        Title="Perfil de Usuario" Height="700" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <!-- Paleta de colores -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#FF2C3E50"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF4FC3F7"/>
        <SolidColorBrush x:Key="CardColor" Color="#FFFDFDFD"/>
        <SolidColorBrush x:Key="AvatarBg" Color="#FF34495E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#FFB0BEC5"/>
        <Color x:Key="ShadowColor">#22000000</Color>
        <!-- Fondo degradado moderno -->
        <LinearGradientBrush x:Key="ModernBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2C3E50" Offset="0"/>
            <GradientStop Color="#FF34495E" Offset="1"/>
        </LinearGradientBrush>
        <!-- Sombra para la tarjeta -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Color="#22000000"/>
        <!-- Botón moderno principal -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0B8C1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Botón plano -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- TextBox moderno -->
        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Background" Value="#FFFDFDFD"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- PasswordBox moderno -->
        <Style TargetType="PasswordBox" x:Key="ModernPasswordBox">
            <Setter Property="Background" Value="#FFFDFDFD"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Background>
        <StaticResource ResourceKey="ModernBackground"/>
    </Window.Background>
    <Window.DataContext>
        <viewModels:UsuarioViewModel />
    </Window.DataContext>
    <Grid>
        <Border CornerRadius="26" Background="{StaticResource CardColor}" Padding="44" Margin="60" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Encabezado con avatar y datos principales -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,36">
                    <Grid Width="100" Height="100">
                        <Ellipse Fill="{StaticResource AvatarBg}" Stroke="{StaticResource PrimaryColor}" StrokeThickness="3"/>
                        <TextBlock Text="{Binding InicialNombre}" FontSize="44" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="36,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NombreCompleto}" FontSize="32" FontWeight="Bold" Foreground="#222"/>
                        <TextBlock Text="{Binding Email}" FontSize="17" Foreground="#888"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Background="{Binding RolColor}" CornerRadius="8" Padding="12,4" Margin="0,0,12,0">
                                <TextBlock Text="{Binding RolNombre}" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{Binding EstadoColor}" CornerRadius="8" Padding="12,4">
                                <TextBlock Text="{Binding EstadoTexto}" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!-- Cuerpo principal -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Datos personales -->
                    <StackPanel Grid.Column="0" Margin="0,0,44,0">
                        <TextBlock Text="Datos personales" FontSize="21" FontWeight="Bold" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Nombre:" Width="120" VerticalAlignment="Center"/>
                            <TextBox Width="260" Height="36" Style="{StaticResource ModernTextBox}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Apellidos:" Width="120" VerticalAlignment="Center"/>
                            <TextBox Width="260" Height="36" Style="{StaticResource ModernTextBox}" Text="{Binding Apellidos, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Email:" Width="120" VerticalAlignment="Center"/>
                            <TextBox Width="260" Height="36" Style="{StaticResource ModernTextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                            <Button Content="💾 Guardar Cambios" Style="{StaticResource ModernButton}" Height="48"/>
                            <Button Content="❌ Cancelar" Style="{StaticResource FlatButton}" Height="48"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Cambiar contraseña y actividad -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Cambiar contraseña" FontSize="21" FontWeight="Bold" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Contraseña actual:" Width="150" VerticalAlignment="Center"/>
                            <PasswordBox Width="220" Height="36" Style="{StaticResource ModernPasswordBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Nueva contraseña:" Width="150" VerticalAlignment="Center"/>
                            <PasswordBox Width="220" Height="36" Style="{StaticResource ModernPasswordBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Confirmar nueva contraseña:" Width="150" VerticalAlignment="Center"/>
                            <PasswordBox Width="220" Height="36" Style="{StaticResource ModernPasswordBox}"/>
                        </StackPanel>
                        <Button Content="🔐 Cambiar Contraseña" Style="{StaticResource ModernButton}" Height="48" Margin="0,22,0,0"/>
                        <TextBlock Text="Historial de actividad" FontSize="21" FontWeight="Bold" Margin="0,40,0,12"/>
                        <Border Background="#F4F6FB" CornerRadius="10" Padding="10" Height="150">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox Height="120"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
