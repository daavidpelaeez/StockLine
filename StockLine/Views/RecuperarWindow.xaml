<Window x:Class="WpfApp1.Views.RecuperarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar Contraseña" 
        Height="550" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Border Background="White" 
            CornerRadius="20" 
            Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#1E88E5" Opacity="0.3" BlurRadius="30" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <Border Background="#E3F2FD"
                       CornerRadius="12"
                       Padding="15,12"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18">
                    <TextBlock Text="🔑" FontSize="45"/>
                </Border>
                <TextBlock Text="Recuperar Contraseña" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1E88E5" Offset="0"/>
                            <GradientStop Color="#42A5F5" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Ingresa tu email para recibir instrucciones" 
                          FontSize="14" 
                          Foreground="#7F8C8D"
                          FontWeight="Medium"
                          HorizontalAlignment="Center"
                          Margin="0,8,0,0"/>
            </StackPanel>

            <!-- CONTENIDO -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Email -->
                <TextBlock Text="Correo Electronico *" 
                          FontSize="15" 
                          FontWeight="SemiBold" 
                          Foreground="#2C3E50"
                          Margin="0,0,0,12"/>
                <Border Background="#F8F9FA"
                       CornerRadius="12"
                       Padding="0"
                       Margin="0,0,0,20"
                       BorderBrush="#E3F2FD"
                       BorderThickness="2">
                    <TextBox x:Name="txtEmail" 
                            Height="55"
                            Padding="18"
                            FontSize="15"
                            BorderThickness="0"
                            Background="Transparent"
                            VerticalContentAlignment="Center"/>
                </Border>

                <!-- Mensaje informativo -->
                <Border Background="#E3F2FD"
                       CornerRadius="10"
                       Padding="15"
                       Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️" 
                                  FontSize="18" 
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Top"/>
                        <TextBlock TextWrapping="Wrap"
                                  FontSize="13"
                                  Foreground="#1E88E5"
                                  LineHeight="20"
                                  Text="Te enviaremos un correo con un enlace para restablecer tu contrasena. Asegurate de revisar tu bandeja de spam."/>
                    </StackPanel>
                </Border>

                <!-- Mensaje de estado -->
                <Border x:Name="borderMensaje"
                       Background="#FFEBEE"
                       BorderBrush="#EF5350"
                       BorderThickness="2"
                       CornerRadius="10"
                       Padding="15,12"
                       Margin="0,0,0,0"
                       Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtIconoMensaje"
                                  Text="❌"
                                  FontSize="18"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtMensaje"
                                  FontWeight="SemiBold"
                                  FontSize="13"
                                  TextWrapping="Wrap"
                                  VerticalAlignment="Center"
                                  Foreground="#C62828"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- BOTONES -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancelar" 
                       Grid.Column="0"
                       Content="Cancelar" 
                       Height="50"
                       Margin="0,0,10,0"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="16"
                       FontWeight="Bold"
                       Cursor="Hand"
                       Click="BtnCancelar_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#95A5A6" Offset="0"/>
                            <GradientStop Color="#7F8C8D" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                   Background="{TemplateBinding Background}" 
                                   CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnEnviar" 
                       Grid.Column="1"
                       Content="Enviar Enlace" 
                       Height="50"
                       Margin="10,0,0,0"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="16"
                       FontWeight="Bold"
                       Cursor="Hand"
                       Click="BtnEnviar_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#42A5F5" Offset="0"/>
                            <GradientStop Color="#1E88E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                   Background="{TemplateBinding Background}" 
                                   CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
