<Window x:Class="WpfApp1.Views.AddEnvioPendiente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir Envío Pendiente"
        Height="400"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="*"/>
            <!-- Formulario -->
            <RowDefinition Height="Auto"/>
            <!-- Botones -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Nuevo Envío Pendiente"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="Black"
                   Margin="0,0,0,20"/>

        <!-- Formulario -->
        <StackPanel Grid.Row="1" >

            <!-- Ayuntamiento -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Ayuntamiento:"
                           Width="120"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="AyuntamientoCombo"
                          Width="300"
                          Height="30"
                          DisplayMemberPath="Nombre"
                          SelectedValuePath="Id"
                          />
            </StackPanel>

            <!-- Producto -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Producto:"
                           Width="120"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="ProductoCombo"
                          Width="300"
                          Height="30"
                          DisplayMemberPath="Nombre"
                          SelectedValuePath="Id"/>
            </StackPanel>

            <!-- Cantidad -->
            <StackPanel Orientation="Horizontal" Margin="3">
                <TextBlock Text="Cantidad:"
                           Width="118"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="CantidadBox"
                         Width="300"
                         Height="30"/>
            </StackPanel>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="LightGray"
                    Foreground="Black"
                    FontWeight="Bold"
                    Click="Cancelar_Click"/>
            <Button Content="Guardar"
                    Width="100"
                    Height="35"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
