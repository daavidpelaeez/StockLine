<Window x:Class="WpfApp1.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stockline - Inicio" Height="800" Width="1200" 
        Background="#F5F7FA" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!-- RECURSOS -->
    <Window.Resources>
        <!-- Estilo para botones de la barra lateral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                Margin="5,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="IconImage" Grid.Column="0" 
                                       Width="22" Height="22" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"/>
                                <TextBlock Grid.Column="1" 
                                          Text="{TemplateBinding Tag}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8EEF5"/>
                                <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para tarjetas de estadísticas -->
        <Style x:Key="StatsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="20" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón de cerrar sesión -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6B6B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF5252"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- GRID PRINCIPAL -->
    <Grid>
        <!-- Borde exterior para simular ventana moderna -->
        <Border Background="White" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="30" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- BARRA LATERAL -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12,0,0,12">
                    <Border Background="#F8FAFB" CornerRadius="12,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- LOGO Y TÍTULO -->
                            <StackPanel Grid.Row="0" Margin="20,30,20,30">
                                <TextBlock Text="Stockline" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="#2C3E50" FontStyle="Italic"/>
                                <TextBlock Text="Sistema de Gestión" 
                                          FontSize="11" 
                                          Foreground="#7F8C8D"
                                          Margin="0,4,0,0" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- MENÚ DE NAVEGACIÓN -->
                            <StackPanel Grid.Row="1" Margin="10,0">
                                <Button x:Name="btnInicio" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Inicio">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#E3F2FD" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" 
                                                           Source="/Assets/Icons/inicio.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Inicio"
                                                              VerticalAlignment="Center"
                                                              Foreground="#1976D2"
                                                              FontWeight="SemiBold"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnUsuarios" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Usuarios">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/usuarios.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Usuarios"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8EEF5"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnAyuntamientos" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Ayuntamientos"
                                       Click="btnAyuntamientos_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/ayuntamiento.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Ayuntamientos"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8EEF5"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnCategorias" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Categorías"
                                       Click="btnCategorias_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="IconText" Grid.Column="0" 
                                                           Text="🏷️"
                                                           FontSize="18"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Categorías"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8EEF5"/>
                                                    <Setter TargetName="IconText" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- NUEVO BOTÓN TARJETAS SIM -->
                                <!--
                                <Button x:Name="btnSIMs" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Tarjetas SIM"
                                       Click="btnSIMs_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="IconText" Grid.Column="0" 
                                                           Text="SIM"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Tarjetas SIM"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8EEF5"/>
                                                    <Setter TargetName="IconText" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                -->

                                <Button x:Name="btnStock" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Stock"
                                       Click="btnStockCompleto_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/stock.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Stock"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8EEF5"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnReportes" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Reportes">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/reportes.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Reportes"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8EEF5"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnAjustes" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Ajustes"
                                       Click="btnAjustes_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/settings.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Ajustes"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8EEF5"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- BOTÓN CERRAR SESIÓN -->
                            <StackPanel Grid.Row="2" Margin="15,0,15,25">
                                <Button x:Name="btnCerrarSesion" 
                                       Content="🔓 Cerrar Sesión" 
                                       Style="{StaticResource LogoutButtonStyle}"
                                       Click="btnCerrarSesion_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- CONTENIDO PRINCIPAL -->
                <Grid Grid.Column="1" Background="#F5F7FA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BARRA SUPERIOR CON TÍTULO DE VENTANA -->
                    <Border Grid.Row="0" Background="White" CornerRadius="0,12,0,0">
                        <Grid Margin="30,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="28" FontWeight="Bold" Foreground="#2C3E50">
                                    <Run Text="¡Hola, "/>
                                    <Run Text="{Binding NombreUsuario}"/>
                                    <Run Text="! 👋"/>
                                </TextBlock>
                                <TextBlock Text="Aquí está el resumen de hoy" 
                                          FontSize="14" 
                                          Foreground="#7F8C8D"
                                          Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Botones de control de ventana -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,15,0,0">
                                <Button Content="─" 
                                       Width="40" Height="30" 
                                       Background="Transparent" 
                                       BorderThickness="0"
                                       FontSize="16"
                                       Foreground="#7F8C8D"
                                       Cursor="Hand"
                                       Click="MinimizeWindow_Click"/>
                                <Button Content="✕" 
                                       Width="40" Height="30" 
                                       Background="Transparent" 
                                       BorderThickness="0"
                                       FontSize="16"
                                       Foreground="#7F8C8D"
                                       Cursor="Hand"
                                       Click="CloseWindow_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TARJETAS DE ESTADÍSTICAS -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="30,30,30,20">
                        <!-- Tarjeta 1: Envíos pendientes -->
                        <Border Style="{StaticResource StatsCardStyle}"
                                MouseLeftButtonUp="TarjetaEnvios_MouseLeftButtonUp" 
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock Text="Envíos Pendientes" 
                                                  FontSize="13" 
                                                  Foreground="#7F8C8D"
                                                  FontWeight="Medium"/>
                                        <TextBlock Text="12" 
                                                  FontSize="36" 
                                                  FontWeight="Bold" 
                                                  Foreground="#3498DB"
                                                  Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Image Source="/Assets/Icons/enviospendientes.png" 
                                           Width="48" Height="48" 
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Opacity="0.75"
                                           />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tarjeta 2: Pedidos recibidos -->
                        <Border Style="{StaticResource StatsCardStyle}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Pedidos Recibidos" 
                                              FontSize="13" 
                                              Foreground="#7F8C8D"
                                              FontWeight="Medium"/>
                                    <TextBlock Text="7" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="#2ECC71"
                                              Margin="0,8,0,0"/>
                                </StackPanel>
                                <Image Source="/Assets/Icons/stock.png" 
                                       Width="48" Height="48" 
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       />
                            </Grid>
                        </Border>

                        <!-- Tarjeta 3: Tareas pendientes -->
                        <Border Style="{StaticResource StatsCardStyle}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Tareas Pendientes" 
                                              FontSize="13" 
                                              Foreground="#7F8C8D"
                                              FontWeight="Medium"/>
                                    <TextBlock Text="3" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="#E74C3C"
                                              Margin="0,8,0,0"/>
                                </StackPanel>
                                <Image Source="/Assets/Icons/reportes.png" 
                                       Width="48" Height="48" 
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       />
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- PANEL DE PRODUCTOS EN STOCK -->
                    <Border Grid.Row="2" 
                            Background="White" 
                            CornerRadius="16" 
                            Padding="30" 
                            Margin="30,0,30,30">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="20" ShadowDepth="0"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Encabezado -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="📊 Productos en Stock" 
                                          FontWeight="Bold" 
                                          FontSize="20"
                                          Foreground="#2C3E50"
                                          VerticalAlignment="Center"/>
                                
                                <Button HorizontalAlignment="Right"
                                       Background="#F8F9FA"
                                       BorderThickness="0"
                                       Width="40" Height="40"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="Filtrar_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10">
                                                <Image Source="/Assets/Icons/filtrar.png" 
                                                       Width="20" Height="20"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8EEF5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Lista de productos -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="panelProductos" Orientation="Vertical"/>
                            </ScrollViewer>

                            <!-- Botón ver stock completo -->
                            <Button x:Name="btnStockCompleto" 
                                   Grid.Row="2"
                                   Content="Ver Stock Completo →" 
                                   Margin="0,20,0,0" 
                                   Height="48" 
                                   Background="#3498DB" 
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Cursor="Hand"
                                   Click="btnStockCompleto_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2980B9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
