<Window x:Class="WpfApp1.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stockline - Inicio" Height="800" Width="1200" 
        Background="#F5F7FA" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!-- RECURSOS -->
    <Window.Resources>
        <!-- Estilo para botones de la barra lateral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="14" Margin="3,3,3,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Barra/acento visual -->
                                    <Border x:Name="AccentBar" Grid.Column="0" Width="8" CornerRadius="4" Background="Transparent"/>
                                    <Image x:Name="IconImage" Grid.Column="1" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" Source="{TemplateBinding Tag}"/>
                                    <TextBlock x:Name="MenuText" Grid.Column="2" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="Bold" FontSize="16"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8EEF5"/>
                                <Setter TargetName="MenuText" Property="Foreground" Value="#22304A"/>
                                <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="#22304A"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#22304A" BlurRadius="8" ShadowDepth="0" Opacity="0.18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#22304A"/>
                                <Setter TargetName="MenuText" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="#22304A"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#22304A" BlurRadius="10" ShadowDepth="0" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para tarjetas de estadísticas -->
        <Style x:Key="StatsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="20" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón de cerrar sesión -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6B6B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF5252"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo moderno para ProgressBar -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#42A5F5" Offset="0.0"/>
                        <GradientStop Color="#1976D2" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#F3F6FA"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="true">
                            <Grid>
                                <Rectangle x:Name="PART_Track" Fill="Transparent" Height="8" RadiusX="4" RadiusY="4"/>
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" Height="8" RadiusX="4" RadiusY="4" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- GRID PRINCIPAL -->
    <Grid>
        <!-- Borde exterior para simular ventana moderna -->
        <Border Background="White" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="30" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- BARRA LATERAL -->
                <Border Grid.Column="0" Background="#D0E3FA" CornerRadius="12,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.18"/>
                    </Border.Effect>
                    <Border Background="#FF2C3E50" CornerRadius="12,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- LOGO Y TÍTULO -->
                            <StackPanel Grid.Row="0" Margin="20,30,20,30">
                                <TextBlock Text="Stockline" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="White" FontStyle="Italic"/>
                                <TextBlock Text="Sistema de Gestión" 
                                          FontSize="11" 
                                          Foreground="White"
                                          Margin="0,4,0,0" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- MENÚ DE NAVEGACIÓN -->
                            <StackPanel Grid.Row="1" Margin="10,0">
                                <!-- SECCIÓN DE NOTIFICACIONES -->
                                <Border Background="#FFF3E0"
                                       CornerRadius="12"
                                       Padding="12"
                                       Margin="5,0,5,15"
                                       BorderBrush="#FFA726"
                                       BorderThickness="2">
                                    <StackPanel>
                                        <!-- Header clickeable -->
                                        <Grid Margin="0,0,0,10"
                                             Background="Transparent"
                                             Cursor="Hand"
                                             MouseLeftButtonDown="ToggleNotificaciones_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔔" FontSize="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="Notificaciones" 
                                                          FontSize="13"
                                                          FontWeight="Bold"
                                                          Foreground="#F57C00"
                                                          VerticalAlignment="Center"/>
                                                <Border Background="#FF6B6B"
                                                       CornerRadius="10"
                                                       Padding="6,2"
                                                       Margin="8,0,0,0"
                                                       x:Name="badgeNotificaciones"
                                                       Visibility="Collapsed">
                                                    <TextBlock x:Name="txtNumNotificaciones"
                                                              Text="0"
                                                              FontSize="10"
                                                              FontWeight="Bold"
                                                              Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <!-- Flecha indicadora alineada a la derecha -->
                                            <TextBlock x:Name="flechaNotificaciones"
                                                      Text="▼"
                                                      FontSize="10"
                                                      Foreground="#F57C00"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      Margin="0,0,5,0"/>
                                        </Grid>

                                        <!-- Panel desplegable de notificaciones -->
                                        <StackPanel x:Name="panelNotificaciones" Visibility="Collapsed">
                                            <!-- Stock Bajo -->
                                            <Border Background="White"
                                                   CornerRadius="8"
                                                   Padding="10"
                                                   Margin="0,0,0,8"
                                                   x:Name="notifStockBajo"
                                                   Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Contenido clickeable -->
                                                    <StackPanel Grid.Column="0" 
                                                               Cursor="Hand"
                                                               MouseLeftButtonDown="NotificacionStockBajo_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Stock Bajo"
                                                                      FontSize="11"
                                                                      FontWeight="Bold"
                                                                      Foreground="#E74C3C"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="txtStockBajo"
                                                                  Text="0 productos"
                                                                  FontSize="10"
                                                                  Foreground="#7F8C8D"
                                                                  Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Botón descartar -->
                                                    <Button Grid.Column="1"
                                                           Width="24" Height="24"
                                                           Background="#27AE60"
                                                           BorderThickness="0"
                                                           Cursor="Hand"
                                                           ToolTip="Descartar notificacion"
                                                           Click="DescartarStockBajo_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                       CornerRadius="12">
                                                                    <TextBlock Text="✓" 
                                                                              FontSize="14" 
                                                                              FontWeight="Bold"
                                                                              Foreground="White"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#27AE60"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#229954"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Envíos Pendientes -->
                                            <Border Background="White"
                                                   CornerRadius="8"
                                                   Padding="10"
                                                   Margin="0,0,0,8"
                                                   x:Name="notifEnviosPendientes"
                                                   Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Contenido clickeable -->
                                                    <StackPanel Grid.Column="0"
                                                               Cursor="Hand"
                                                               MouseLeftButtonDown="NotificacionEnviosPendientes_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📦" FontSize="14" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Envios Pendientes"
                                                                      FontSize="11"
                                                                      FontWeight="Bold"
                                                                      Foreground="#3498DB"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="txtEnviosPendientes"
                                                                  Text="0 envios"
                                                                  FontSize="10"
                                                                  Foreground="#7F8C8D"
                                                                  Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Botón descartar -->
                                                    <Button Grid.Column="1"
                                                           Width="24" Height="24"
                                                           Background="#27AE60"
                                                           BorderThickness="0"
                                                           Cursor="Hand"
                                                           ToolTip="Descartar notificacion"
                                                           Click="DescartarEnviosPendientes_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                       CornerRadius="12">
                                                                    <TextBlock Text="✓" 
                                                                              FontSize="14" 
                                                                              FontWeight="Bold"
                                                                              Foreground="White"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#27AE60"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#229954"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Sin notificaciones -->
                                            <Border x:Name="sinNotificaciones"
                                                   Background="White"
                                                   CornerRadius="8"
                                                   Padding="10"
                                                   Margin="0,0,0,8">
                                                <TextBlock Text="✅ Sin alertas"
                                                          FontSize="11"
                                                          Foreground="#27AE60"
                                                          TextAlignment="Center"/>
                                            </Border>

                                            <!-- Botón Actualizar -->
                                            <Button Content="🔄 Actualizar"
                                                   Height="28"
                                                   Margin="0,0,0,0"
                                                   Background="#F57C00"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Cursor="Hand"
                                                   Click="ActualizarNotificaciones_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                               CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#EF6C00"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="btnInicio" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Inicio"
                                       Background="#FF2F3644"
                                       Foreground="White"
                                       FontStyle="Italic"
                                       FontSize="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" 
                                                           Source="/Assets/Icons/perfil.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="Mi perfil"
                                                              VerticalAlignment="Center"
                                                              Foreground="#FFFFFF"
                                                              FontWeight="SemiBold"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnUsuarios" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Usuarios"
                                       Click="btnUsuarios_Click" Foreground="White" FontStyle="Italic" FontSize="16">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/usuarios.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock x:Name="MenuText" Grid.Column="1" 
                                                              Text="Usuarios"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnAyuntamientos" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Ayuntamientos"
                                       Click="btnAyuntamientos_Click" FontStyle="Italic" Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/ayuntamiento.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock x:Name="MenuText" Grid.Column="1" 
                                                              Text="Ayuntamientos"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnCategorias" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Categorías"
                                       Click="btnCategorias_Click" Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="IconText" Grid.Column="0" 
                                                           Text="🏷️"
                                                           FontSize="18"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock x:Name="MenuText" Grid.Column="1" 
                                                              Text="Categorías"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="IconText" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- BOTÓN TARJETAS SIM -->
                                <Button x:Name="btnSIMs" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Tarjetas SIM"
                                       Click="btnSIMs_Click" Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="IconText" Grid.Column="0" 
                                                           Text="SIM"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock x:Name="MenuText" Grid.Column="1" 
                                                              Text="Tarjetas SIM"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="IconText" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnStock" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Stock"
                                       Click="btnStockCompleto_Click" Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/stock.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock x:Name="MenuText" Grid.Column="1" 
                                                              Text="Stock"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnMovimientosStock" 
       Style="{StaticResource SidebarButtonStyle}"
       Tag="Movimientos Stock"
       Click="btnMovimientosStock_Click" Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                    CornerRadius="10"
                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                           Source="/Assets/Icons/controlStock.png"
                           Width="22" Height="22" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.7"/>
                                                    <TextBlock x:Name="MenuText" Grid.Column="1" 
                              Text="Movimientos Stock"
                              VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnReportes" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Reportes"
                                       Click="btnReportes_Click" Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/reportes.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock x:Name="MenuText" Grid.Column="1" 
                                                              Text="Reportes"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnAjustes" 
                                       Style="{StaticResource SidebarButtonStyle}"
                                       Tag="Ajustes"
                                       Click="btnAjustes_Click" Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="10"
                                                    Margin="5,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image x:Name="IconImage" Grid.Column="0" 
                                                           Source="/Assets/Icons/settings.png"
                                                           Width="22" Height="22" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"/>
                                                    <TextBlock x:Name="MenuText" Grid.Column="1" 
                                                              Text="Ajustes"
                                                              VerticalAlignment="Center"
                                                              Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="IconImage" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- BOTÓN CERRAR SESIÓN -->
                            <StackPanel Grid.Row="2" Margin="15,0,15,25">
                                <Button x:Name="btnCerrarSesion" 
                                       Style="{StaticResource LogoutButtonStyle}"
                                       Click="btnCerrarSesion_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/Assets/Icons/apagar.png" Width="20" Height="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="Cerrar Sesión" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- CONTENIDO PRINCIPAL -->
                <Grid Grid.Column="1" Background="#FFF5F9FD">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BARRA SUPERIOR CON TÍTULO DE VENTANA -->
                    <Border Grid.Row="0" Background="White" CornerRadius="0,12,0,0">
                        <Grid Margin="30,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="28" FontWeight="Bold" Foreground="#2C3E50">
                                    <Run Text="¡Hola, "/>
                                    <Run Text="{Binding NombreUsuario}"/>

                                </TextBlock>
                                <TextBlock Text="Aquí está el resumen de hoy" 
                                          FontSize="14" 
                                          Foreground="#7F8C8D"
                                          Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Botones de control de ventana -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,15,0,0">
                                <Button Content="─" 
                                       Width="40" Height="30" 
                                       Background="Transparent" 
                                       BorderThickness="0"
                                       FontSize="16"
                                       Foreground="#7F8C8D"
                                       Cursor="Hand"
                                       Click="MinimizeWindow_Click"/>
                                <Button Content="☐" 
                                       Width="40" Height="30" 
                                       Background="Transparent" 
                                       BorderThickness="0"
                                       FontSize="16"
                                       Foreground="#7F8C8D"
                                       Cursor="Hand"
                                       Click="MaximizeWindow_Click"/>
                                <Button Content="✕" 
                                       Width="40" Height="30" 
                                       Background="#FF6B6B" 
                                       BorderThickness="0"
                                       FontSize="16"
                                       Foreground="White"
                                       Cursor="Hand"
                                       Click="CloseWindow_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TARJETAS DE ESTADÍSTICAS -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="30,30,30,20">
                        <!-- Tarjeta 1: Envíos pendientes -->
                        <Border Style="{StaticResource StatsCardStyle}"
                                MouseLeftButtonUp="TarjetaEnvios_MouseLeftButtonUp" 
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock Text="Envíos Pendientes" 
                                                  FontSize="13" 
                                                  Foreground="#7F8C8D"
                                                  FontWeight="Medium"/>
                                        <TextBlock x:Name="txtKpiEnviosPendientes"
                                                  Text="12" 
                                                  FontSize="36" 
                                                  FontWeight="Bold" 
                                                  Foreground="#3498DB"
                                                  Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Image Source="/Assets/Icons/enviospendientes.png" 
                                           Width="48" Height="48" 
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Opacity="0.75"
                                           />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tarjeta 2: SIMs disponibles -->
                        <Border Style="{StaticResource StatsCardStyle}" MouseLeftButtonUp="TarjetaSIMs_MouseLeftButtonUp" Cursor="Hand">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="SIMs disponibles" 
                                              FontSize="13" 
                                              Foreground="#7F8C8D"
                                              FontWeight="Medium"/>
                                    <TextBlock x:Name="txtKpiSIMsDisponibles"
                                              Text="0" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="#42A5F5"
                                              Margin="0,8,0,0"/>
                                </StackPanel>
                                <Image Source="/Assets/Icons/sim.png" 
                                       Width="48" Height="48" 
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Tarjeta 3: Productos con stock bajo -->
                        <Border Style="{StaticResource StatsCardStyle}" MouseLeftButtonUp="TarjetaStockBajo_MouseLeftButtonUp" Cursor="Hand">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Stock Bajo" 
                                              FontSize="13" 
                                              Foreground="#7F8C8D"
                                              FontWeight="Medium"/>
                                    <TextBlock x:Name="txtKpiStockBajo"
                                              Text="0" 
                                              FontSize="36" 
                                              FontWeight="Bold" 
                                              Foreground="#E74C3C"
                                              Margin="0,8,0,0"/>
                                </StackPanel>
                                <Image Source="/Assets/Icons/stock.png" 
                                       Width="48" Height="48" 
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2"
                            CornerRadius="24"
                            Padding="0"
                            Margin="30,0,30,30"
                            Background="White"
                            BorderBrush="#FF47577D"
                            BorderThickness="2,2,2,2">
                        <Border.Effect>
                            <DropShadowEffect Color="#1976D2" Opacity="0.08" BlurRadius="24" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Encabezado y botón Filtrar en la misma fila -->
                            <Grid Grid.Row="0" Margin="32,32,32,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Encabezado alineado a la izquierda -->
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="Productos en Stock" FontWeight="Bold" FontSize="22" Foreground="#2C3E50"/>
                                    <TextBlock Text="Control y estado actual del inventario" FontSize="13" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Botón Filtrar alineado a la derecha -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="1">
                                    <TextBlock Text="Filtrar" FontSize="15" Foreground="#2C3E50" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Background="Transparent" BorderThickness="0" Width="36" Height="36" Cursor="Hand" Click="Filtrar_Click" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="8">
                                                    <Image Source="/Assets/Icons/filtrar.png" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E8EEF5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Lista de productos como tarjetas -->
                            <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Background="Transparent" Grid.Row="1">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ItemsControl x:Name="panelProductos" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Width="Auto"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>

                            <!-- Botón ver stock completo -->
                            <Button x:Name="btnStockCompleto"
                                    Content="Ver Stock Completo →"
                                    Margin="32,32,32,32"
                                    Height="52"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Foreground="White"
                                    Click="btnStockCompleto_Click"
                                    Grid.Row="2">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#42A5F5" Offset="0.0"/>
                                        <GradientStop Color="#1976D2" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#1976D2" Offset="0.0"/>
                                                            <GradientStop Color="#42A5F5" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
