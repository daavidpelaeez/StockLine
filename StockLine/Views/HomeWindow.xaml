<Window x:Class="WpfApp1.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HomeWindow" Height="750" Width="900" Background="#F8F8F8" WindowStartupLocation="CenterScreen">

    <!-- RECURSOS -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" Opacity="0.1" BlurRadius="4"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5EA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D1D1D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- GRID PRINCIPAL -->
    <Grid Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Barra lateral -->
            <ColumnDefinition Width="*"/>
            <!-- Contenido principal -->
        </Grid.ColumnDefinitions>

        <!-- BARRA LATERAL -->
        <StackPanel Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" Margin="20">
            <TextBlock Text="Stockline" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="Inicio" Margin="0,5" BorderBrush="Black" FontWeight="Bold" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Button Content="Usuarios" Margin="0,5" FontWeight="Bold" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Button x:Name="btnAyuntamientos" Content="Ayuntamientos" Margin="0,5" FontWeight="Bold" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Click="btnAyuntamientos_Click"/>
            <Button Content="Stock" Margin="0,5" FontWeight="Bold" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Button Content="Reportes" Margin="0,5" FontWeight="Bold" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Button Content="Ajustes" Margin="0,5" FontWeight="Bold" BorderBrush="Black" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Button x:Name="btnCerrarSesion" Content="Cerrar Sesión" Margin="0,20,0,0" Background="#FF6B6B" Foreground="White" Click="btnCerrarSesion_Click"/>
        </StackPanel>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Tarjetas de estadísticas -->
                <RowDefinition Height="*"/>
                <!-- Stock productos -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,15,0,20">
                <StackPanel Orientation="Vertical">
                    <TextBlock FontSize="24" FontWeight="Bold">
                        <Run Text="Bienvenido, "/>
                        <Run Text="{Binding NombreUsuario}"/>
                    </TextBlock>
                    <TextBlock Text="Resumen de tu aplicación" FontSize="14" Foreground="Black" FontWeight="Bold"/>
                </StackPanel>
                <Button Content="⚙" DockPanel.Dock="Right" Width="40" Height="40" Background="Transparent" FontSize="20"/>
            </DockPanel>

            <!-- Fondo general de sección de estadísticas -->
            <Grid Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" Margin="0,20,10,20">
                <!-- gris muy suave de fondo -->
                <UniformGrid Columns="3">

                    <!-- Tarjeta 1 -->
                    <Border CornerRadius="15" Padding="20" Margin="10"
                    MouseLeftButtonUp="TarjetaEnvios_MouseLeftButtonUp" Cursor="Hand">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#E0E0E5" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#888888" Opacity="0.8" BlurRadius="12" ShadowDepth="4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Envíos pendientes" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="12" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 2 -->
                    <Border CornerRadius="15" Padding="20" Margin="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#E0E0E5" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#888888" Opacity="0.8" BlurRadius="12" ShadowDepth="4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Pedidos recibidos" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="7" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 3 -->
                    <Border CornerRadius="15" Padding="20" Margin="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#E0E0E5" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#888888" Opacity="0.8" BlurRadius="12" ShadowDepth="4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Tareas pendientes" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="3" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </Grid>




            <!-- PANEL DE STOCK -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,168,0,27" Grid.RowSpan="2" BorderBrush="Black">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" Opacity="0.1" BlurRadius="8" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Encabezado con icono a la derecha -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <!-- Toma todo el espacio disponible -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Icono se ajusta a su tamaño -->
                        </Grid.ColumnDefinitions>

                        <!-- Título -->
                        <TextBlock Text="Productos en stock" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>

                        <!-- Icono filtrar a la derecha -->
                        <Image Grid.Column="1" Source="/Assets/Icons/filtrar.png" Width="24" Height="24" Margin="5,0,0,0" Cursor="Hand"
                         VerticalAlignment="Center" MouseLeftButtonUp="Filtrar_Click"/>
                    </Grid>

                    <!-- Mini panel con productos -->
                    <StackPanel x:Name="panelProductos" Orientation="Vertical">

                        <!-- Producto 1 -->
                        <Border Background="#F8F8F8" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Producto A" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="120 unidades" FontSize="12" Foreground="Gray"/>
                                <ProgressBar Value="120" Maximum="2000" Height="6" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Producto 2 -->
                        <Border Background="#F8F8F8" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Producto B" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="45 unidades" FontSize="12" Foreground="Gray"/>
                                <ProgressBar Value="45" Maximum="2000" Height="6" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Producto 3 -->
                        <Border Background="#F8F8F8" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Producto C" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="200 unidades" FontSize="12" Foreground="Gray"/>
                                <ProgressBar Value="200" Maximum="2000" Height="6" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Producto 4 -->
                        <Border Background="#F8F8F8" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Producto D" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="15 unidades" FontSize="12" Foreground="Red"/>
                                <ProgressBar Value="15" Maximum="2000" Height="6" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Botón ver stock completo -->
                    <Button x:Name="btnStockCompleto" Content="Ver stock completo" Margin="0,15,0,0" Height="35" Background="#4A90E2" Foreground="White" Click="btnStockCompleto_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="Gray" Opacity="0.2" BlurRadius="6" ShadowDepth="2"/>
                        </Button.Effect>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
