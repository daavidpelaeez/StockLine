<Window x:Class="WpfApp1.Views.CrearEditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionar Usuario" 
        Height="720" Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="720"
        MinWidth="850">
    
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F7FA" Offset="0"/>
            <GradientStop Color="#E8EDF2" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border Background="White" CornerRadius="20" Margin="30">
        <Border.Effect>
            <DropShadowEffect Color="#1E88E5" Opacity="0.2" BlurRadius="30" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid Margin="55">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,45">
                <Border Background="#E3F2FD"
                       CornerRadius="12"
                       Padding="15,12"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18">
                    <Image Source="/Assets/Icons/usuarios.png"
                           Width="45"
                           Height="45"/>
                </Border>
                <TextBlock x:Name="txtTitulo" 
                          Text="Nuevo Usuario" 
                          FontSize="36" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1E88E5" Offset="0"/>
                            <GradientStop Color="#42A5F5" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Completa la informacion del usuario" 
                          FontSize="16" 
                          Foreground="#7F8C8D"
                          FontWeight="Medium"
                          HorizontalAlignment="Center"
                          Margin="0,12,0,0"/>
            </StackPanel>

            <!-- FORMULARIO -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,35"
                         HorizontalAlignment="Stretch">
                <StackPanel MaxWidth="700">
                    <!-- Nombre -->
                    <TextBlock Text="Nombre *" 
                              FontSize="16" 
                              FontWeight="SemiBold" 
                              Foreground="#2C3E50"
                              Margin="0,0,0,14"/>
                    <Border Background="#F8F9FA"
                           CornerRadius="12"
                           Padding="0"
                           Margin="0,0,0,30"
                           BorderBrush="#E3F2FD"
                           BorderThickness="2">
                        <TextBox x:Name="txtNombre" 
                                Height="70"
                                Padding="22"
                                FontSize="17"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Apellidos -->
                    <TextBlock Text="Apellidos *" 
                              FontSize="16" 
                              FontWeight="SemiBold" 
                              Foreground="#2C3E50"
                              Margin="0,0,0,14"/>
                    <Border Background="#F8F9FA"
                           CornerRadius="12"
                           Padding="0"
                           Margin="0,0,0,30"
                           BorderBrush="#E3F2FD"
                           BorderThickness="2">
                        <TextBox x:Name="txtApellidos" 
                                Height="70"
                                Padding="22"
                                FontSize="17"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Email -->
                    <TextBlock Text="Email *" 
                              FontSize="16" 
                              FontWeight="SemiBold" 
                              Foreground="#2C3E50"
                              Margin="0,0,0,14"/>
                    <Border Background="#F8F9FA"
                           CornerRadius="12"
                           Padding="0"
                           Margin="0,0,0,30"
                           BorderBrush="#E3F2FD"
                           BorderThickness="2">
                        <TextBox x:Name="txtEmail" 
                                Height="70"
                                Padding="22"
                                FontSize="17"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                    </Border>

                    <!-- Rol -->
                    <TextBlock Text="Rol *" 
                              FontSize="16" 
                              FontWeight="SemiBold" 
                              Foreground="#2C3E50"
                              Margin="0,0,0,14"/>
                    <Border Background="#F8F9FA"
                           CornerRadius="12"
                           Padding="0"
                           Margin="0,0,0,0"
                           BorderBrush="#E3F2FD"
                           BorderThickness="2">
                        <ComboBox x:Name="cbRol" 
                                 Height="60"
                                 Padding="22,0"
                                 FontSize="17"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Usuario" Tag="1"/>
                            <ComboBoxItem Content="Comercial" Tag="2"/>
                            <ComboBoxItem Content="Admin" Tag="3"/>
                        </ComboBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- BOTONES -->
            <Grid Grid.Row="2" Margin="0,0,0,0" MaxWidth="700">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancelar" 
                       Grid.Column="0"
                       Content="Cancelar" 
                       Height="62"
                       Margin="0,0,15,0"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="18"
                       FontWeight="Bold"
                       Cursor="Hand"
                       Click="BtnCancelar_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#95A5A6" Offset="0"/>
                            <GradientStop Color="#7F8C8D" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                   Background="{TemplateBinding Background}" 
                                   CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnGuardar" 
                       Grid.Column="1"
                       Content="Guardar" 
                       Height="62"
                       Margin="15,0,0,0"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="18"
                       FontWeight="Bold"
                       Cursor="Hand"
                       Click="BtnGuardar_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#66BB6A" Offset="0"/>
                            <GradientStop Color="#27AE60" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                   Background="{TemplateBinding Background}" 
                                   CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
