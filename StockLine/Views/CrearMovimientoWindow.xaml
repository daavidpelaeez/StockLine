<Window x:Class="WpfApp1.Views.CrearMovimientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Movimiento" Height="400" Width="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock Text="Crear Movimiento" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Rellena todos los campos obligatorios" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <Label Content="Producto"/>
            <ComboBox x:Name="cbProducto" DisplayMemberPath="Nombre" SelectedValuePath="ProductoID" Margin="0,0,0,8"/>
            <Label Content="Cantidad"/>
            <TextBox x:Name="txtCantidad" Margin="0,0,0,8"/>
            <Label Content="Tipo de movimiento"/>
            <ComboBox x:Name="cbTipo" Margin="0,0,0,8">
                <ComboBoxItem Content="Entrada"/>
                <ComboBoxItem Content="Salida"/>
            </ComboBox>
            <Label Content="Usuario ID"/>
            <TextBox x:Name="txtUsuario" Margin="0,0,0,8"/>
            <Label Content="Observaciones"/>
            <TextBox x:Name="txtObservaciones" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="Cancelar_Click" Margin="0,0,8,0"/>
            <Button Content="Crear" Click="Crear_Click"/>
        </StackPanel>
    </Grid>
</Window>