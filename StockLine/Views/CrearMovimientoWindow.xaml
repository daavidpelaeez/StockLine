<Window x:Class="WpfApp1.Views.CrearMovimientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Movimiento" Height="480" Width="520" WindowStartupLocation="CenterOwner" Background="#F5F7FA" WindowStyle="None" ResizeMode="NoResize">
    <Border Background="#FF2C3E50" CornerRadius="16" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,18">
                <TextBlock Text="Crear Movimiento" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Rellena todos los campos obligatorios" FontSize="13" Foreground="White"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,0">
                <TextBlock Text="Producto" FontWeight="SemiBold" FontSize="14" Foreground="White" Margin="0,0,0,4"/>
                <ComboBox x:Name="cbProducto" DisplayMemberPath="Nombre" SelectedValuePath="ProductoID" Height="40" Margin="0,0,0,12"/>
                <TextBlock Text="Cantidad" FontWeight="SemiBold" FontSize="14" Foreground="#FFEAEFF7" Margin="0,0,0,4"/>
                <TextBox x:Name="txtCantidad" Height="40" FontSize="14" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="0,0,0,12"/>
                <TextBlock Text="Tipo de movimiento" FontWeight="SemiBold" FontSize="14" Foreground="White" Margin="0,0,0,4"/>
                <ComboBox x:Name="cbTipo" Height="40" Margin="0,0,0,12">
                    <ComboBoxItem Content="Entrada"/>
                    <ComboBoxItem Content="Salida"/>
                </ComboBox>
                <TextBlock Text="Observaciones" FontWeight="SemiBold" FontSize="14" Foreground="#FFE6E6E6" Margin="0,0,0,4"/>
                <TextBox x:Name="txtObservaciones" Height="60" FontSize="14" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1.5" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancelar" Click="Cancelar_Click" Width="120" Height="42" Background="#95A5A6" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <Button Content="Crear" Click="Crear_Click" Width="120" Height="42" Background="#27AE60" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>