<Window x:Class="WpfApp1.Views.CrearEditarSIMWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionar SIM" 
        Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        ResizeMode="NoResize">

    <Border Background="White" CornerRadius="12" Margin="15">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="txtTitulo" 
                          Text="Nueva Tarjeta SIM" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50"/>
                <TextBlock Text="Ingresa el numero de la tarjeta SIM" 
                          FontSize="13" 
                          Foreground="#7F8C8D"
                          Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Numero de SIM" 
                          FontSize="13" 
                          FontWeight="SemiBold" 
                          Foreground="#2C3E50"
                          Margin="0,0,0,8"/>
                <TextBox x:Name="txtNumeroSIM" 
                        Height="45"
                        Padding="12"
                        FontSize="14"
                        BorderBrush="#BDC3C7"
                        BorderThickness="1"
                        VerticalContentAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancelar" 
                       Grid.Column="0"
                       Content="Cancelar" 
                       Height="45"
                       Margin="0,0,5,0"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>

                <Button x:Name="btnGuardar" 
                       Grid.Column="1"
                       Content="Guardar" 
                       Height="45"
                       Margin="5,0,0,0"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
