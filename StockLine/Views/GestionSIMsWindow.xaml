<Window x:Class="WpfApp1.Views.GestionSIMsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion de Tarjetas SIM" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,0,0">
                <TextBlock Text="Gestion de Tarjetas SIM" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Administra las tarjetas SIM del sistema" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                <Button Content="-" Width="40" Height="30" Background="Transparent" BorderThickness="0" FontSize="16" FontFamily="Segoe UI" Foreground="#7F8C8D" Cursor="Hand" Click="MinimizeWindow_Click"/>
                <Button Width="40" Height="30" Background="Transparent" BorderThickness="0" FontSize="16" FontFamily="Segoe UI" Foreground="#7F8C8D" Cursor="Hand" Click="MaximizeWindow_Click">
                    <TextBlock Text="&#x25A1;" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Content="x" Width="40" Height="30" Background="#FF6B6B" BorderThickness="0" FontSize="16" FontFamily="Segoe UI" Foreground="White" Cursor="Hand" Click="CloseWindow_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="10" 
                Padding="20" 
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtBuscar" 
                        Grid.Column="0"
                        Height="40"
                        Padding="10"
                        FontSize="13"
                        VerticalContentAlignment="Center"
                        BorderBrush="#BDC3C7"
                        BorderThickness="1"/>

                <ComboBox x:Name="cbFiltroEstado" 
                         Grid.Column="1"
                         Width="150"
                         Height="40"
                         Margin="10,0,0,0"
                         VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Todas" IsSelected="True"/>
                    <ComboBoxItem Content="Disponibles"/>
                    <ComboBoxItem Content="Asignadas"/>
                </ComboBox>

                <Button x:Name="btnNuevaSIM" 
                       Grid.Column="2"
                       Content="Nueva SIM" 
                       Height="40"
                       Padding="20,10"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Cursor="Hand"
                       Margin="10,0,0,0"/>

                <Button x:Name="btnActualizar" 
                       Grid.Column="3"
                       Content="Actualizar" 
                       Height="40"
                       Padding="20,10"
                       Background="#3498DB"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Cursor="Hand"
                       Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="10" 
                Padding="0">
            <DataGrid x:Name="dgSIMs" 
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     GridLinesVisibility="None"
                     HeadersVisibility="Column"
                     Background="White"
                     BorderThickness="0"
                     RowHeight="50"
                     FontSize="13">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding SIMID}" Width="80"/>
                    <DataGridTextColumn Header="Numero SIM" Binding="{Binding NumeroSIM}" Width="*"/>
                    <DataGridTextColumn Header="Producto Asignado" Binding="{Binding ProductoNombre}" Width="*"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                    
                    <DataGridTemplateColumn Header="Acciones" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="btnEditar"
                                           Content="Editar" 
                                           Width="80"
                                           Height="32"
                                           Margin="5,0"
                                           Background="#3498DB"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Cursor="Hand"
                                           Tag="{Binding}"
                                           Click="BtnEditarSIM_Click"/>
                                    
                                    <Button x:Name="btnAsignar"
                                           Content="Asignar" 
                                           Width="80"
                                           Height="32"
                                           Margin="5,0"
                                           Background="#F39C12"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Cursor="Hand"
                                           Tag="{Binding}"
                                           Click="BtnAsignarSIM_Click"/>
                                    
                                    <Button x:Name="btnEliminar"
                                           Content="Eliminar" 
                                           Width="90"
                                           Height="32"
                                           Margin="5,0"
                                           Background="#E74C3C"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Cursor="Hand"
                                           Tag="{Binding}"
                                           Click="BtnEliminarSIM_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button x:Name="btnVolver"
                   Content="Volver" 
                   Width="120"
                   HorizontalAlignment="Left"
                   Height="40"
                   Padding="20,10"
                   Background="#95A5A6"
                   Foreground="White"
                   BorderThickness="0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Cursor="Hand"
                   Click="BtnVolver_Click"/>

            <TextBlock x:Name="txtTotalSIMs" 
                      Text="Total de SIMs: 0" 
                      FontSize="14"
                      FontWeight="SemiBold"
                      Foreground="#2C3E50"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
