<Window x:Class="WpfApp1.Views.AjustesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes y Configuración" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        MinHeight="750"
        MinWidth="1100"
        Background="#F5F7FA">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1E88E5" Opacity="0.15" BlurRadius="25" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E88E5" Offset="0"/>
                        <GradientStop Color="#42A5F5" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER MODERNIZADO -->
        <Border Grid.Row="0" 
                Background="White"
                CornerRadius="16"
                Padding="30,25"
                Margin="0,0,0,25">
            <Border.Effect>
                <DropShadowEffect Color="#1E88E5" Opacity="0.15" BlurRadius="25" ShadowDepth="0"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="32" FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1E88E5" Offset="0"/>
                                    <GradientStop Color="#42A5F5" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <Run Text="Ajustes y Configuración"/>
                        </TextBlock>
                        <TextBlock Text="Personaliza tu experiencia en StockLine" 
                                  FontSize="14" 
                                  Foreground="#7F8C8D"
                                  FontWeight="Medium"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                    <Button Content="─" Width="40" Height="30" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#7F8C8D" Cursor="Hand" Click="MinimizeWindow_Click"/>
                    <Button Content="☐" Width="40" Height="30" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#7F8C8D" Cursor="Hand" Click="MaximizeWindow_Click"/>
                    <Button Content="✕" Width="40" Height="30" Background="#FF6B6B" BorderThickness="0" FontSize="16" Foreground="White" Cursor="Hand" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUMNA IZQUIERDA -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    
                    <!-- INFORMACIÓN DEL PROYECTO -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="#E8F5E9"
                                       CornerRadius="10"
                                       Padding="10"
                                       Margin="0,0,12,0">
                                    <TextBlock Text="📚" FontSize="24"/>
                                </Border>
                                <TextBlock Text="Información del Proyecto" 
                                          Style="{StaticResource SectionTitle}"
                                          VerticalAlignment="Center"
                                          Margin="0"/>
                            </StackPanel>

                            <TextBlock Text="Nombre del Proyecto" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="StockLine - Sistema de Gestión" Style="{StaticResource InfoValue}"/>

                            <TextBlock Text="Versión" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="1.0.0 - 2º DAM" Style="{StaticResource InfoValue}"/>

                            <TextBlock Text="Descripción" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="Sistema integral de gestión de stock, envíos y ayuntamientos desarrollado como proyecto de fin de ciclo." 
                                      Style="{StaticResource InfoValue}"
                                      TextWrapping="Wrap"/>

                            <TextBlock Text="Tecnologías" Style="{StaticResource InfoLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="#E3F2FD" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                    <TextBlock Text="WPF" Foreground="#1E88E5" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <Border Background="#E8F5E9" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                    <TextBlock Text="C#" Foreground="#27AE60" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <Border Background="#FFF3E0" CornerRadius="8" Padding="10,6">
                                    <TextBlock Text=".NET 4.8" Foreground="#F57C00" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DESARROLLADOR -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="#E8F5E9"
                                       CornerRadius="10"
                                       Padding="10"
                                       Margin="0,0,12,0">
                                    <TextBlock Text="👨‍💻" FontSize="24"/>
                                </Border>
                                <TextBlock Text="Desarrollador" 
                                          Style="{StaticResource SectionTitle}"
                                          VerticalAlignment="Center"
                                          Margin="0"/>
                            </StackPanel>

                            <TextBlock Text="Nombre" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="David Peláez" Style="{StaticResource InfoValue}"/>

                            <TextBlock Text="Proyecto" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="Proyecto de 2º DAM" Style="{StaticResource InfoValue}"/>

                            <TextBlock Text="Fecha de Desarrollo" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="2024 - 2025" Style="{StaticResource InfoValue}"/>

                            <TextBlock Text="Centro Educativo" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="IES - Desarrollo de Aplicaciones Multiplataforma" 
                                      Style="{StaticResource InfoValue}"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- COLUMNA DERECHA -->
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    
                    <!-- CONFIGURACIÓN DE NOTIFICACIONES -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="#FFF3E0"
                                       CornerRadius="10"
                                       Padding="10"
                                       Margin="0,0,12,0">
                                    <TextBlock Text="🔔" FontSize="24"/>
                                </Border>
                                <TextBlock Text="Notificaciones" 
                                          Style="{StaticResource SectionTitle}"
                                          VerticalAlignment="Center"
                                          Margin="0"/>
                            </StackPanel>

                            <!-- Notificación 1 -->
                            <Border Background="#F8F9FA" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Notificar nuevos envíos" 
                                                  FontWeight="SemiBold" 
                                                  FontSize="15"
                                                  Foreground="#2C3E50"/>
                                        <TextBlock Text="Recibe alertas cuando se registre un nuevo envío" 
                                                  FontSize="12"
                                                  Foreground="#7F8C8D"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <CheckBox Grid.Column="1" 
                                             x:Name="chkNotificarEnvios"
                                             IsChecked="True" 
                                             VerticalAlignment="Center"
                                             Width="50" Height="26">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Grid>
                                                    <Border x:Name="border" 
                                                           Width="50" Height="26" 
                                                           CornerRadius="13" 
                                                           Background="#95A5A6"/>
                                                    <Ellipse x:Name="ellipse" 
                                                            Width="20" Height="20" 
                                                            Fill="White" 
                                                            HorizontalAlignment="Left" 
                                                            Margin="3,0,0,0"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                                                        <Setter TargetName="ellipse" Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter TargetName="ellipse" Property="Margin" Value="0,0,3,0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>
                                </Grid>
                            </Border>

                            <!-- Notificación 2 -->
                            <Border Background="#F8F9FA" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Notificar stock bajo" 
                                                  FontWeight="SemiBold" 
                                                  FontSize="15"
                                                  Foreground="#2C3E50"/>
                                        <TextBlock Text="Alertas cuando el stock esté por debajo del mínimo" 
                                                  FontSize="12"
                                                  Foreground="#7F8C8D"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <CheckBox Grid.Column="1" 
                                             x:Name="chkNotificarStock"
                                             IsChecked="True" 
                                             VerticalAlignment="Center"
                                             Width="50" Height="26">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Grid>
                                                    <Border x:Name="border" 
                                                           Width="50" Height="26" 
                                                           CornerRadius="13" 
                                                           Background="#95A5A6"/>
                                                    <Ellipse x:Name="ellipse" 
                                                            Width="20" Height="20" 
                                                            Fill="White" 
                                                            HorizontalAlignment="Left" 
                                                            Margin="3,0,0,0"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                                                        <Setter TargetName="ellipse" Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter TargetName="ellipse" Property="Margin" Value="0,0,3,0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>
                                </Grid>
                            </Border>

                            <!-- Notificación 3 -->
                            <Border Background="#F8F9FA" CornerRadius="12" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Notificar errores del sistema" 
                                                  FontWeight="SemiBold" 
                                                  FontSize="15"
                                                  Foreground="#2C3E50"/>
                                        <TextBlock Text="Recibe notificaciones sobre errores críticos" 
                                                  FontSize="12"
                                                  Foreground="#7F8C8D"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <CheckBox Grid.Column="1" 
                                             x:Name="chkNotificarErrores"
                                             IsChecked="False" 
                                             VerticalAlignment="Center"
                                             Width="50" Height="26">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Grid>
                                                    <Border x:Name="border" 
                                                           Width="50" Height="26" 
                                                           CornerRadius="13" 
                                                           Background="#95A5A6"/>
                                                    <Ellipse x:Name="ellipse" 
                                                            Width="20" Height="20" 
                                                            Fill="White" 
                                                            HorizontalAlignment="Left" 
                                                            Margin="3,0,0,0"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                                                        <Setter TargetName="ellipse" Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter TargetName="ellipse" Property="Margin" Value="0,0,3,0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ACERCA DE -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="#E3F2FD"
                                       CornerRadius="10"
                                       Padding="10"
                                       Margin="0,0,12,0">
                                    <TextBlock Text="ℹ️" FontSize="24"/>
                                </Border>
                                <TextBlock Text="Acerca de" 
                                          Style="{StaticResource SectionTitle}"
                                          VerticalAlignment="Center"
                                          Margin="0"/>
                            </StackPanel>

                            <TextBlock Text="Licencia" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="MIT License - Software Educativo" Style="{StaticResource InfoValue}"/>

                            <TextBlock Text="Repositorio" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="https://github.com/daavidpelaeez/StockLine" 
                                      Style="{StaticResource InfoValue}"
                                      TextDecorations="Underline"
                                      Foreground="#1E88E5"
                                      Cursor="Hand"
                                      MouseLeftButtonDown="Repository_Click"/>

                            <TextBlock Text="Estado del Servidor" Style="{StaticResource InfoLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Ellipse Width="12" Height="12" Fill="#27AE60" Margin="0,0,10,0"/>
                                <TextBlock Text="Conectado" 
                                          Foreground="#27AE60" 
                                          FontWeight="Bold"
                                          FontSize="14"/>
                                <TextBlock Text=" - API en http://localhost:5200" 
                                          Foreground="#7F8C8D"
                                          FontSize="13"
                                          Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- Botón Acerca de -->
                            <Button Height="50"
                                   BorderThickness="0"
                                   Cursor="Hand"
                                   Foreground="White"
                                   Click="BtnAcercaDe_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#42A5F5" Offset="0"/>
                                        <GradientStop Color="#1E88E5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ️" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Más información del proyecto" 
                                              FontSize="15" 
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

