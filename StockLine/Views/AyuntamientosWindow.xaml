<Window x:Class="WpfApp1.Views.AyuntamientosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayuntamientos" Height="560" Width="900"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
        <Style TargetType="TextBox" x:Key="SearchBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Ayuntamientos" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="  " />
            <TextBlock Text="Gestiona los ayuntamientos" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="6,6,0,0"/>
        </StackPanel>

        <!-- Search + actions -->
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBox x:Name="SearchBox" Width="360" Style="{StaticResource SearchBox}"  TextChanged="SearchBox_TextChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" >
                <Button x:Name="BtnAdd" Content="Añadir" Style="{StaticResource PrimaryButton}" Click="BtnAdd_Click" Margin="6,0"/>
                <Button x:Name="BtnEdit" Content="Editar" Style="{StaticResource SecondaryButton}" Click="BtnEdit_Click" Margin="6,0" Width="100"/>
                <Button x:Name="BtnDelete" Content="Eliminar" Style="{StaticResource SecondaryButton}" Click="BtnDelete_Click" Margin="6,0" Width="100"/>
            </StackPanel>
        </DockPanel>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid x:Name="GrdAyuntamientos" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                      RowHeaderWidth="0" IsReadOnly="True" ItemsSource="{Binding}" SelectionChanged="GrdAyuntamientos_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="140"/>
                    <DataGridTextColumn Header="CP" Binding="{Binding CodigoPostal}" Width="90"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="130"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FAFBFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E6F0FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Footer (info) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
