<Window x:Class="WpfApp1.Views.AyuntamientosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stockline - Gestión de Ayuntamientos"
        Height="900"
        Width="1600"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Colores modernos actualizados a azul marino #2C3E50 -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#2ECC71"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E74C3C"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F39C12"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="HoverColor" Color="#34495E"/>

        <!-- Estilo para títulos -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Estilo para cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="24" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario azul marino -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón Success -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
        </Style>

        <!-- TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid moderno -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="70"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F2F5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6EAF8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E1BEE7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Borde exterior de la ventana -->
    <Border Background="White" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER DE LA VENTANA -->
            <Border Grid.Row="0" 
                    Background="#FF2C3E50" 
                    CornerRadius="16,16,0,0"
                    BorderBrush="#FF2C3E50"
                    BorderThickness="0,0,0,1">
                <Grid Height="80" Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo/Icono -->
                    <Border Width="56" Height="56" 
                            CornerRadius="14" 
                            Background="{DynamicResource BackgroundBrush}"
                            VerticalAlignment="Center">
                        <Image Source="/icons/ayuntamiento.png" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Título -->
                    <StackPanel Grid.Column="1" 
                              VerticalAlignment="Center" 
                              Margin="20,0,0,0">
                        <TextBlock Text="Gestión de Ayuntamientos" 
                                 Style="{StaticResource TitleStyle}" Foreground="White"/>
                        <TextBlock Text="Administra todos los ayuntamientos del sistema" 
                                 Style="{StaticResource SubtitleStyle}" Foreground="White"/>
                    </StackPanel>

                    <!-- Botones de control de ventana -->
                    <StackPanel Grid.Column="2" 
                              Orientation="Horizontal" 
                              VerticalAlignment="Center">
                        <Button Content="─" 
                               Width="44" Height="44" 
                               Background="Transparent" 
                               BorderThickness="0"
                               FontSize="20"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Cursor="Hand"
                               Click="MinimizeWindow_Click"
                               Margin="0,0,8,0"/>
                        <Button Content="☐" 
                               Width="44" Height="44" 
                               Background="Transparent" 
                               BorderThickness="0"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Cursor="Hand"
                               Click="MaximizeWindow_Click"
                               Margin="0,0,8,0"/>
                        <Button Content="✕" 
                               Width="40" Height="30" 
                               Background="#2C3E50" 
                               BorderThickness="0"
                               FontSize="16"
                               Foreground="White"
                               Cursor="Hand"
                               Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO PRINCIPAL -->
            <Grid Grid.Row="1" Background="{StaticResource BackgroundColor}" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de búsqueda y acciones -->
                <Border Grid.Row="0" 
                        Style="{StaticResource CardStyle}"
                        Margin="24,24,24,16"
                        Padding="20" Background="#FF2C3E50">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Filtrar por estado:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                            <ComboBox x:Name="ComboEstado" Width="120" SelectionChanged="ComboEstado_SelectionChanged">
                                <ComboBoxItem Content="Todos" IsSelected="True"/>
                                <ComboBoxItem Content="Activos"/>
                                <ComboBoxItem Content="Inactivos"/>
                            </ComboBox>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Búsqueda -->
                            <Grid Grid.Column="0">
                                <TextBox x:Name="txtBuscar" 
                                       Style="{StaticResource ModernTextBox}"
                                       Width="500"
                                       HorizontalAlignment="Left"/>
                            </Grid>

                            <!-- Botón Actualizar -->

                            <!-- Botón Nuevo Ayuntamiento -->
                            <Button Grid.Column="2" 
                                  Content="+ Nuevo Ayuntamiento" 
                                  Style="{StaticResource SuccessButton}"
                                  Width="210"
                                  Click="BtnNuevoAyuntamiento_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tabla de ayuntamientos -->
                <Border Grid.Row="1" 
                        Style="{StaticResource CardStyle}"
                        Margin="24,0,24,16">
                    <DataGrid x:Name="dgAyuntamientos" 
                            Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AyuntamientoID}" Width="80"/>
                            
                            <DataGridTemplateColumn Header="Ayuntamiento" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" 
                                                   CornerRadius="21"
                                                   Margin="0,0,12,0"
                                                   Background="{StaticResource PrimaryColor}">
                                                <TextBlock Text="{Binding InicialNombre}" 
                                                         FontSize="18" 
                                                         FontWeight="Bold" 
                                                         Foreground="White"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}" 
                                                         FontWeight="SemiBold"
                                                         Foreground="{StaticResource TextPrimaryColor}"/>
                                                <TextBlock Text="{Binding Direccion}" 
                                                         FontSize="12"
                                                         Foreground="{StaticResource TextSecondaryColor}"
                                                         Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="140"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                            
                            <DataGridTemplateColumn Header="Comercial" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E8F5E9"
                                               CornerRadius="8"
                                               Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💼" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding ComercialNombre}" 
                                                         Foreground="{StaticResource SuccessColor}"
                                                         FontSize="12"
                                                         FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Acciones" Width="340">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Ver"
                                                   Width="90"
                                                   Height="36"
                                                   Margin="4,0"
                                                   Background="#2C3E50"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   Tag="{Binding}"
                                                   Click="BtnVer_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                               CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="Editar"
                                                   Width="90"
                                                   Height="36"
                                                   Margin="4,0"
                                                   Background="#F39C12"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   Tag="{Binding}"
                                                   Click="BtnEditar_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                               CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="Eliminar"
                                                   Width="100"
                                                   Height="36"
                                                   Margin="4,0"
                                                   Background="#E74C3C"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   Tag="{Binding}"
                                                   Click="BtnEliminar_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                               CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Footer con estadísticas -->
                <Border Grid.Row="2" 
                        Background="Transparent"
                        Margin="24,0,24,24">
                    <Grid>
                        <TextBlock x:Name="txtTotalAyuntamientos"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextSecondaryColor}"
                                 FontSize="13">
                            <Run Text="Total de ayuntamientos: "/>
                            <Run Text="0" FontWeight="Bold"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
