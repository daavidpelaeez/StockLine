<Window x:Class="WpfApp1.Views.AddProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="AddProduct" Height="610" Width="910">
    <!-- Recursos: colores y estilos simples -->
    <Window.Resources>
        <!-- Colores -->
        <Color x:Key="PrimaryColor">#2D9CDB</Color>
        <Color x:Key="AccentColor">#4CAF50</Color>
        <Color x:Key="Surface">#FFFFFF</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E5E7EB"/>

        <!-- TextBox style (flat, rounded) -->
        <Style TargetType="TextBox" x:Key="FlatTextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style (reuses TextBox visual) -->
        <Style TargetType="ComboBox" x:Key="FlatComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <DockPanel Margin="6,0">
                                    <ContentPresenter Margin="2" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="ToggleButton" DockPanel.Dock="Right" Width="30" Background="Transparent" BorderThickness="0">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </DockPanel>
                            </Border>
                            <Popup Name="PART_Popup" Placement="Bottom" StaysOpen="False">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer MaxHeight="200" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleButton" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
        </Style>

        <!-- Small muted label -->
        <Style TargetType="TextBlock" x:Key="LabelSmall">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Form label -->
        <Style TargetType="TextBlock" x:Key="FormLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal con card -->
    <Grid Margin="18">
        <Border Background="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}" CornerRadius="12" Padding="18" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="0 0 0 14">
                    <TextBlock x:Name="txtProductoVentana" FontSize="20" FontWeight="Bold" Foreground="#0F172A"><Run Language="en-gb" Text="P"/><Run Text="roducto"/></TextBlock>
                    <TextBlock Text="  " />
                </StackPanel>

                <!-- Body: dos columnas -->
                <Grid Grid.Row="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: campos -->
                    <StackPanel Grid.Column="0" Margin="6,0,20,0" VerticalAlignment="Top" >

                        <!-- Nombre -->
                        <StackPanel Margin="0,6">
                            <TextBlock Text="Nombre" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="NombreBox" Style="{StaticResource FlatTextBox}" BorderBrush="Black" />
                        </StackPanel>

                        <!-- Descripción -->
                        <StackPanel Margin="0,6">
                            <TextBlock Text="Descripción" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="DescripcionBox" Style="{StaticResource FlatTextBox}" AcceptsReturn="True" Height="130" TextWrapping="Wrap" BorderBrush="Black"/>
                        </StackPanel>

                        <UniformGrid Columns="2" Rows="1" Margin="0,6" HorizontalAlignment="Stretch">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Cantidad" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="CantidadBox" Style="{StaticResource FlatTextBox}" BorderBrush="Black"/>
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0">
                                <TextBlock Text="Categoria" Style="{StaticResource FormLabel}" />
                                <ComboBox 
                                    x:Name="CategoriaComboBox" 
                                    Height="32"
                                    DisplayMemberPath="Nombre"
                                    SelectedValuePath="CategoriaID"
                                    BorderBrush="Black"
                                    Margin="1" Text="" Background="{x:Null}"
                                    />
                            </StackPanel>


                        </UniformGrid>
                        <!-- Foto (ruta escondida), se muestra en la derecha -->
                        <StackPanel Margin="0,8" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:Name="BtnSeleccionarFoto" Content="Seleccionar foto" Click="SeleccionarFoto_Click" Style="{StaticResource PrimaryButton}" Width="140"/>
                            <Button Content="Limpiar" Click="LimpiarFoto_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Width="90" BorderBrush="Black" Background="{DynamicResource BorderBrushColor}"/>
                            <TextBlock Text="  " />
                            <TextBlock x:Name="FotoNombre" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Right: preview imagen y info rápida -->
                    <Border Grid.Column="1" Background="#FAFAFB" CornerRadius="8" Padding="10" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" >
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Previsualización" Style="{StaticResource FormLabel}" Margin="0,0,0,8"/>
                            <Border Height="220" CornerRadius="8" Background="#FFF" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" 
                                AllowDrop="True" Drop="ImageDrop_Drop" DragOver="ImageDrop_DragOver">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewHint" Text="Arrastra la imagen aquí o pulsa 'Seleccionar foto'" Foreground="{StaticResource MutedBrush}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12" Visibility="Visible"/>
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Detalles rápidos" Style="{StaticResource LabelSmall}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <TextBlock Text="Nombre: " FontWeight="SemiBold" Width="90"/>
                                    <TextBlock x:Name="QuickNombre" Text="—" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Cantidad: " FontWeight="SemiBold" Width="90"/>
                                    <TextBlock x:Name="QuickCantidad" Text="—" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Descripcion: " FontWeight="SemiBold" Width="90"/>
                                    <TextBlock x:Name="QuickDescripcion" Text="—" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer: botones -->
                <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancelar" Click="Cancelar_Click" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,12,0" Background="#FFFF4F4F" Foreground="White"/>
                    <Button Content="Guardar producto" Click="Guardar_Click" Style="{StaticResource PrimaryButton}" Width="150"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
