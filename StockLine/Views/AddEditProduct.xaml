<Window x:Class="WpfApp1.Views.AddProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="Stockline - Gestionar Producto" 
        Height="850" 
        Width="1300"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Paleta de colores moderna y minimalista -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#6366F1"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#4F46E5"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#64748B"/>
        <SolidColorBrush x:Key="HoverColor" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="AccentLight" Color="#EEF2FF"/>

        <!-- Estilo para cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="16" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox moderno -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Botón primario -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Success -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Danger -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label estilo -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <!-- Borde exterior de la ventana -->
    <Border Background="{StaticResource BackgroundColor}" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.15" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER DE LA VENTANA -->
            <Border Grid.Row="0" 
                    Background="{StaticResource SurfaceColor}" 
                    CornerRadius="16,16,0,0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid Height="72" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo/Icono -->
                    <Border Width="48" Height="48" 
                            CornerRadius="12" 
                            Background="{StaticResource PrimaryColor}"
                            VerticalAlignment="Center">
                        <TextBlock Text="📦" 
                                 FontSize="24" 
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Center"/>
                    </Border>

                    <!-- Título -->
                    <StackPanel Grid.Column="1" 
                              VerticalAlignment="Center" 
                              Margin="16,0,0,0">
                        <TextBlock x:Name="txtProductoVentana"
                                 Text="Nuevo Producto" 
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Completa los datos del producto" 
                                 FontSize="13"
                                 Foreground="{StaticResource TextSecondaryColor}"
                                 Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Botón cerrar -->
                    <Button Grid.Column="2" 
                           Content="✕" 
                           Width="40" Height="40" 
                           Background="Transparent" 
                           BorderThickness="0"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryColor}"
                           Cursor="Hand"
                           Click="Cancelar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                   Background="{TemplateBinding Background}"
                                                   CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENIDO PRINCIPAL -->
            <Grid Grid.Row="1" Background="{StaticResource BackgroundColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Formulario -->
                <Border Grid.Column="0" 
                        Style="{StaticResource CardStyle}"
                        Margin="24,20,12,24">
                    <StackPanel>
                        <TextBlock Text="Información del Producto" 
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryColor}"
                                  Margin="0,0,0,24"/>

                        <!-- Nombre -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Nombre del Producto *" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="NombreBox" 
                                    Style="{StaticResource ModernTextBox}"
                                    TextChanged="NombreBox_TextChanged"/>
                        </StackPanel>

                        <!-- Descripción -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Descripción" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="DescripcionBox" 
                                    Style="{StaticResource ModernTextBox}"
                                    Height="140"
                                    AcceptsReturn="True" 
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top"
                                    Padding="14,12"
                                    TextChanged="DescripcionBox_TextChanged"/>
                        </StackPanel>

                        <!-- Cantidad y Categoría -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cantidad -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cantidad en Stock *" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="CantidadBox" 
                                        Style="{StaticResource ModernTextBox}"
                                        TextChanged="CantidadBox_TextChanged"/>
                            </StackPanel>

                            <!-- Categoría -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Categoría *" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="CategoriaComboBox" 
                                         Style="{StaticResource ModernComboBox}"
                                         DisplayMemberPath="Nombre"
                                         SelectedValuePath="CategoriaID"/>
                            </StackPanel>
                        </Grid>

                        <!-- Foto -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Imagen del Producto" Style="{StaticResource FormLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                       x:Name="BtnSeleccionarFoto" 
                                       Content="📁 Seleccionar Foto" 
                                       Style="{StaticResource SecondaryButton}"
                                       Width="180"
                                       Click="SeleccionarFoto_Click"/>

                                <Button Grid.Column="1"
                                       Content="🗑️ Limpiar" 
                                       Style="{StaticResource SecondaryButton}"
                                       Width="110"
                                       Margin="12,0,0,0"
                                       Click="LimpiarFoto_Click"/>

                                <TextBlock Grid.Column="2"
                                          x:Name="FotoNombre" 
                                          VerticalAlignment="Center" 
                                          Foreground="{StaticResource TextSecondaryColor}" 
                                          Margin="16,0,0,0"
                                          FontStyle="Italic"
                                          FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Columna Derecha: Preview y Detalles -->
                <Border Grid.Column="1" 
                        Style="{StaticResource CardStyle}"
                        Margin="12,20,24,24">
                    <StackPanel>
                        <TextBlock Text="Vista Previa" 
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryColor}"
                                  Margin="0,0,0,24"/>

                        <!-- Preview Imagen -->
                        <Border Height="360" 
                               CornerRadius="12" 
                               Background="#F8FAFC" 
                               BorderBrush="{StaticResource BorderColor}" 
                               BorderThickness="2"
                               AllowDrop="True" 
                               Drop="ImageDrop_Drop" 
                               DragOver="ImageDrop_DragOver"
                               Margin="0,0,0,24">
                            <Grid>
                                <Image x:Name="PreviewImage" 
                                      Stretch="Uniform" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      Margin="12"/>
                                <StackPanel x:Name="PreviewHint" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Visibility="Visible">
                                    <TextBlock Text="🖼️" 
                                             FontSize="48"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,12"/>
                                    <TextBlock Text="Arrastra la imagen aquí" 
                                             Foreground="{StaticResource TextPrimaryColor}" 
                                             HorizontalAlignment="Center"
                                             FontSize="14"
                                             FontWeight="SemiBold"/>
                                    <TextBlock Text="o usa el botón de seleccionar" 
                                             Foreground="{StaticResource TextSecondaryColor}" 
                                             HorizontalAlignment="Center"
                                             FontSize="12"
                                             Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Detalles Rápidos -->
                        <Border Background="{StaticResource AccentLight}"
                               CornerRadius="12"
                               Padding="20"
                               Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Resumen" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryColor}"
                                          Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                              Text="Nombre:" 
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextSecondaryColor}"
                                              Width="90"/>
                                    <TextBlock Grid.Column="1"
                                              x:Name="QuickNombre" 
                                              Text="—"
                                              TextWrapping="Wrap"
                                              Foreground="{StaticResource TextPrimaryColor}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                              Text="Cantidad:" 
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextSecondaryColor}"
                                              Width="90"/>
                                    <TextBlock Grid.Column="1"
                                              x:Name="QuickCantidad" 
                                              Text="—"
                                              Foreground="{StaticResource TextPrimaryColor}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                              Text="Descripción:" 
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextSecondaryColor}"
                                              Width="90"
                                              VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                              x:Name="QuickDescripcion" 
                                              Text="—"
                                              TextWrapping="Wrap"
                                              MaxHeight="80"
                                              Foreground="{StaticResource TextPrimaryColor}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Botones de Acción -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0"
                                   Content="Cancelar" 
                                   Style="{StaticResource DangerButton}"
                                   Margin="0,0,8,0"
                                   Click="Cancelar_Click"/>
                            <Button Grid.Column="1"
                                   Content="💾 Guardar" 
                                   Style="{StaticResource SuccessButton}"
                                   Margin="8,0,0,0"
                                   Click="Guardar_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
