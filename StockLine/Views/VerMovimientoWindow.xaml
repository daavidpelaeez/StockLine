<Window x:Class="WpfApp1.Views.VerMovimientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Movimiento" Height="340" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" Background="#F5F7FA">
    <Border Background="White" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="18" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Barra superior moderna -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                <TextBlock Text="Detalle de Movimiento" FontWeight="Bold" FontSize="18" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="?" Width="36" Height="28" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#7F8C8D" Cursor="Hand" Click="MinimizeWindow_Click"/>
                    <Button Content="?" Width="36" Height="28" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#7F8C8D" Cursor="Hand" Click="Cerrar_Click"/>
                </StackPanel>
            </DockPanel>
            <!-- Detalle -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock x:Name="txtFecha" FontSize="14" Foreground="#34495E"/>
                <TextBlock x:Name="txtTipo" FontSize="14" Foreground="#34495E"/>
                <TextBlock x:Name="txtProducto" FontSize="14" Foreground="#34495E"/>
                <TextBlock x:Name="txtCantidad" FontSize="14" Foreground="#34495E"/>
                <TextBlock x:Name="txtUsuario" FontSize="14" Foreground="#34495E"/>
                <TextBlock x:Name="txtObservaciones" FontSize="14" Foreground="#7F8C8D" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>