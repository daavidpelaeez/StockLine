<Window x:Class="WpfApp1.Views.AsignarSIMProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asignar SIM a Producto" 
        Height="350" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        ResizeMode="NoResize">

    <Border Background="White" CornerRadius="12" Margin="15">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Asignar SIM a Producto" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#2C3E50"/>
                <TextBlock x:Name="txtSubtitulo" 
                          FontSize="13" 
                          Foreground="#7F8C8D"
                          Margin="0,5,0,0"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Producto" 
                          FontSize="13" 
                          FontWeight="SemiBold" 
                          Foreground="#2C3E50"
                          Margin="0,0,0,8"/>
                
                <ComboBox x:Name="cbProducto" 
                         Height="45"
                         Padding="12"
                         FontSize="14"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         DisplayMemberPath="Nombre"
                         SelectedValuePath="ProductoID"
                         Margin="0,0,0,15"/>

                <CheckBox x:Name="chkDesasignar" 
                         Content="Desasignar SIM del producto actual"
                         FontSize="13"
                         Foreground="#2C3E50"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Si la SIM ya esta asignada, se desasignara automaticamente del producto anterior" 
                          FontSize="12" 
                          Foreground="#95A5A6"
                          FontStyle="Italic"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancelar" 
                       Grid.Column="0"
                       Content="Cancelar" 
                       Height="45"
                       Margin="0,0,5,0"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>

                <Button x:Name="btnAsignar" 
                       Grid.Column="1"
                       Content="Asignar" 
                       Height="45"
                       Margin="5,0,0,0"
                       Background="#F39C12"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
