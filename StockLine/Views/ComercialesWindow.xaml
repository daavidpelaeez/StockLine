<Window x:Class="WpfApp1.Views.ComercialesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="ComercialesWindow" Height="450" Width="800">
    <Window.Resources>
        <!-- Colores y estilos reutilizables -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="DangerBrush"   Color="#E74C3C"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#555555"/>
        <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#333333"/>
        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        </Style>
        <!-- Estilo para los encabezados del DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <!-- Estilo de fila con hover y selección -->
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F9FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Comerciales"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource HeaderForegroundBrush}"
                   Margin="0,0,0,20"/>

        <!-- DataGrid de Comerciales -->
        <DataGrid x:Name="dataGridComerciales"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#E8F0FE"
                  RowBackground="White"
                  GridLinesVisibility="None"
                  FontSize="14"
                  SelectionMode="Single"
                  ItemsSource="{Binding Comerciales}"
                  SelectedItem="{Binding ComercialesSeleccionado, Mode=TwoWay}"
                  Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="150"/>
                <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                <DataGridTextColumn Header="Ayuntamiento" Binding="{Binding Ayuntamiento}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones inferiores -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    HorizontalAlignment="Right">
            <Button x:Name="btnAgregar" Content="Agregar"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ComandoAgregar}"/>
            <Button x:Name="btnEditar" Content="Editar"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ComandoEditar}"
                    />
            <Button x:Name="btnEliminar" Content="Eliminar"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding ComandoEliminar}"
                    />
        </StackPanel>
    </Grid>
</Window>
