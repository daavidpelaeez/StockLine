<Window x:Class="WpfApp1.Views.FiltroStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtro de stock"
        Height="610"
        Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Colores de la aplicación -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#2980B9"/>
        <SolidColorBrush x:Key="PrimaryActive" Color="#1E5FA8"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#27AE60"/>
        <SolidColorBrush x:Key="SuccessHover" Color="#229954"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#64748B"/>
        <SolidColorBrush x:Key="HoverColor" Color="#F1F5F9"/>

        <!-- Botón primario mejorado -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SuccessHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario mejorado -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón rápido mejorado -->
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Overlay semi-transparente -->
    <Grid Background="#00000000">
        <!-- Card centrada con sombra mejorada -->
        <Border Width="500" 
                Padding="32" 
                CornerRadius="16" 
                Background="{StaticResource SurfaceColor}"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.25" BlurRadius="50" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header mejorado -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Ajustar Filtros de Progreso" 
                              FontSize="20" 
                              FontWeight="Bold" 
                              Foreground="{StaticResource TextPrimaryColor}"/>
                    <TextBlock Text="Configura el máximo de las barras de progreso" 
                              FontSize="12" 
                              Foreground="{StaticResource TextSecondaryColor}"
                              Margin="0,6,0,0"
                              FontWeight="Normal"/>
                </StackPanel>

                <!-- Contenido principal -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,24">
                    <!-- Slider con valor -->
                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Valor máximo" 
                                      FontSize="12" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextPrimaryColor}"/>
                            <Border Background="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" 
                                   CornerRadius="6" 
                                   Padding="12,6"
                                   HorizontalAlignment="Right">
                                <TextBlock x:Name="txtValor" 
                                          Text="2000" 
                                          FontWeight="Bold" 
                                          Foreground="White"
                                          FontSize="13"/>
                            </Border>
                        </Grid>
                        
                        <Slider x:Name="sliderMaximo"
                                Minimum="100"
                                Maximum="5000"
                                Value="2000"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Height="24"
                                Foreground="{StaticResource PrimaryColor}"
                                Background="{StaticResource BackgroundColor}"/>
                    </StackPanel>

                    <!-- Botones rápidos -->
                    <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                        <TextBlock Text="Valores rápidos" 
                                  FontSize="12" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryColor}"
                                  Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button x:Name="btnRapido500" 
                                   Content="500" 
                                   Style="{StaticResource QuickButton}" 
                                   Margin="0,0,10,0" 
                                   Click="QuickValue_Click"
                                   ToolTip="Establecer a 500 unidades"/>
                            <Button x:Name="btnRapido1000" 
                                   Content="1000" 
                                   Style="{StaticResource QuickButton}" 
                                   Margin="0,0,10,0" 
                                   Click="QuickValue_Click"
                                   ToolTip="Establecer a 1000 unidades"/>
                            <Button x:Name="btnRapido2000" 
                                   Content="2000" 
                                   Style="{StaticResource QuickButton}" 
                                   Margin="0,0,10,0" 
                                   Click="QuickValue_Click"
                                   ToolTip="Establecer a 2000 unidades"/>
                            <Button x:Name="btnRapido5000" 
                                   Content="5000" 
                                   Style="{StaticResource QuickButton}" 
                                   Click="QuickValue_Click"
                                   ToolTip="Establecer a 5000 unidades"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Ayuda mejorada -->
                <Border Grid.Row="2" 
                        Background="#E3F2FD"
                        BorderBrush="#BBDEFB"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="💡 Información" 
                                  FontSize="11" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource PrimaryColor}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="Este valor define el máximo de las barras de progreso. Los productos con stock superior serán mostrados al 100%."
                                  FontSize="11"
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  TextWrapping="Wrap"
                                  LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- Separador visual -->
                <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource BorderColor}" Margin="0,0,0,16"/>

                <!-- Botones de acción mejorados -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" 
                           Click="Cancelar_Click" 
                           Style="{StaticResource SecondaryButton}"
                           Width="120"
                           Margin="0,0,12,0"/>
                    <Button Content="✓ Aplicar" 
                           Click="Aceptar_Click" 
                           Style="{StaticResource PrimaryButton}"
                           Width="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
