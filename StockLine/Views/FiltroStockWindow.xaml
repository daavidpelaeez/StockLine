<Window x:Class="WpfApp1.Views.FiltroStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtro de stock"
        Height="260"
        Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#80000000"   
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Botones -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>

        <!-- Small label style -->
        <Style x:Key="LabelSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>
    </Window.Resources>

    <!-- Contenedor: centro con card -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Card centrada -->
        <Border Width="420" Padding="18" CornerRadius="12" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{DynamicResource DropShadowEffect}">
            

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                        <TextBlock Text="Filtrar stock" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Ajusta el máximo de las barras de progreso" Style="{StaticResource LabelSmall}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Close small X -->
                    <Button DockPanel.Dock="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="Cancelar_Click" ToolTip="Cerrar">
                        <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="#9CA3AF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </DockPanel>

                <!-- Body -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,6,0,6">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,10">
                        <Slider x:Name="sliderMaximo"
                                Minimum="0"
                                Maximum="5000"
                                Value="2000"
                                TickFrequency="100"
                                IsSnapToTickEnabled="False"
                                Width="280"
                                VerticalAlignment="Center"/>
                        <Border Background="#F3F4F6" CornerRadius="6" Padding="8" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtValor" Text="2000" FontWeight="SemiBold" Foreground="#111827"/>
                        </Border>
                    </StackPanel>

                    <!-- Rango rápido -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4" HorizontalAlignment="Left">
                        <TextBlock Text="Rápido:" Style="{StaticResource LabelSmall}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="btnRapido500" Content="500" Style="{StaticResource SecondaryButton}" Width="64" Height="30" Margin="0,0,8,0" Click="QuickValue_Click"/>
                        <Button x:Name="btnRapido1000" Content="1000" Style="{StaticResource SecondaryButton}" Width="64" Height="30" Margin="0,0,8,0" Click="QuickValue_Click"/>
                        <Button x:Name="btnRapido2000" Content="2000" Style="{StaticResource SecondaryButton}" Width="64" Height="30" Margin="0,0,8,0" Click="QuickValue_Click"/>
                        <Button x:Name="btnRapido5000" Content="5000" Style="{StaticResource SecondaryButton}" Width="64" Height="30" Click="QuickValue_Click"/>
                    </StackPanel>

                    <!-- Ayuda / hint -->
                    <TextBlock Text="Usa el deslizador para ajustar el máximo que se aplica a las barras de progreso" 
                               Style="{StaticResource LabelSmall}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="10" FontWeight="Bold"/>
                </StackPanel>

                <!-- Footer: botones -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Cancelar" Click="Cancelar_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Aceptar" Click="Aceptar_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
