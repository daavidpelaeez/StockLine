<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login Inventario" Height="450" Width="800"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">
        
    <Grid Background="{DynamicResource LoginBackgroundBrush}">

        <!-- Botón para cambiar tema -->
        <Button Content="Cambiar Tema"
                Width="120"
                Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                Click="ToggleTheme_Click"
                Background="{DynamicResource PrimaryBrush}"
                Foreground="White"
                FontWeight="Bold" />

        <!-- Panel de login -->
        <Border Background="White" CornerRadius="15" Padding="30" Width="300" Height="340"
                VerticalAlignment="Center" HorizontalAlignment="Center" 
                Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>

                <TextBlock Text="Iniciar Sesión" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Usuario -->
                <TextBlock Text="Usuario" FontWeight="SemiBold" Margin="5,0,0,5" Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="txtUser" Height="30" FontSize="14" Padding="5" Width="229" />

                <!-- Contraseña -->
                <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="5,10,0,5" Foreground="{DynamicResource TextBrush}"/>
                <PasswordBox x:Name="txtPassword" Height="30" FontSize="14" Padding="5" Width="223"/>

                <!-- ¿Olvidó contraseña? -->
                <TextBlock Text="¿Olvidó su contraseña?"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="12"
                           Cursor="Hand"
                           TextDecorations="Underline"
                           HorizontalAlignment="Center"
                           MouseDown="ForgotPassword_Click"
                           Padding="0,10,0,0"/>

                <!-- Botón login -->
                <Button Content="Entrar"
                        Height="35"
                        Margin="0,25,0,0"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnLogin_Click"/>

                <!-- Mensaje de error -->
                <TextBlock x:Name="txtError"
                           Foreground="Red"
                           FontWeight="Bold"
                           Margin="0,15,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
