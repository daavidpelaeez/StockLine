<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colores claros profesionales -->
    <Color x:Key="PrimaryColor">#FF4A90E2</Color>
    <!-- Azul principal -->
    <Color x:Key="PrimaryDarkColor">#FF357ABD</Color>
    <!-- Azul oscuro -->
    <Color x:Key="AccentColor">#FF50E3C2</Color>
    <!-- Verde agua -->
    <Color x:Key="BackgroundColor">#FFF9FAFB</Color>
    <!-- Blanco muy suave -->
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <!-- Blanco para superficies -->
    <Color x:Key="TextColorPrimary">#FF222222</Color>
    <!-- Texto principal oscuro -->
    <Color x:Key="TextColorSecondary">#FF555555</Color>
    <!-- Texto secundario -->
    <Color x:Key="DisabledColor">#FFBDBDBD</Color>
    <!-- Texto/Control deshabilitado -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextColorPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextColorSecondary}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />

    <!-- Fondo degradado suave para login -->
    <LinearGradientBrush x:Key="LoginBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF4A90E2" Offset="0.0" />
        <GradientStop Color="#FF357ABD" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>